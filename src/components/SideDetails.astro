---
// SideDetails.astro: comic-style doodles in the empty space left and right of the page.
// Only shows on wide screens (where there is spare room beside the content), sits behind
// everything, and can't be clicked. Lines use the ink colour, so they follow night mode.
// Drawn by us for Build Play Collect: ruler lines, stickers, sparkles, hobby dots and a box buddy.
import { HOBBIES } from '../data/site';

const dots = Object.values(HOBBIES).map((h) => h.color);
const star = 'M0 -12 C 2 -3 3 -2 12 0 C 3 2 2 3 0 12 C -2 3 -3 2 -12 0 C -3 -2 -2 -3 0 -12 Z';
---
<div class="side-deco side-left" aria-hidden="true">
  <svg viewBox="0 0 160 900" preserveAspectRatio="xMidYMin meet">
    <!-- Ruler: a thick line with tick marks, plus a thin dashed partner -->
    <line class="sd-line" x1="22" y1="0" x2="22" y2="900" />
    <line class="sd-dash" x1="34" y1="0" x2="34" y2="900" />
    {Array.from({ length: 30 }, (_, i) => <line class="sd-tick" x1="22" x2={i % 5 ? 30 : 40} y1={i * 30 + 15} y2={i * 30 + 15} />)}
    <!-- Round sticker -->
    <g transform="translate(100 120) rotate(-12)">
      <circle class="sd-shadow" cx="5" cy="5" r="46" />
      <circle class="sd-fill" r="46" fill="#ffd23f" />
      <circle class="sd-thin" r="41" />
      <text class="sd-text" y="-3">STAY</text>
      <text class="sd-text" y="15">CURIOUS</text>
    </g>
    <!-- One dot per hobby colour -->
    {dots.map((c, i) => <circle class="sd-fill" cx={i % 2 ? 112 : 88} cy={250 + i * 30} r="9" fill={c} />)}
    <path class="sd-star" transform="translate(70 500) scale(1.3)" d={star} />
    <path class="sd-star" transform="translate(126 560) scale(.8)" d={star} />
    <!-- Squiggle -->
    <path class="sd-line sd-thinline" d="M64 620 q 14 -16 28 0 t 28 0 t 28 0" />
    <path class="sd-line sd-thinline" d="M64 642 q 14 -16 28 0 t 28 0 t 28 0" />
    <!-- Tag -->
    <g transform="translate(100 730) rotate(8)">
      <rect class="sd-shadow" x="-46" y="-16" width="92" height="32" rx="16" transform="translate(4 4)" />
      <rect class="sd-fill" x="-46" y="-16" width="92" height="32" rx="16" fill="#ff8fc7" />
      <text class="sd-text" y="5">EST. 2026</text>
    </g>
    <path class="sd-star" transform="translate(76 830) scale(.7)" d={star} />
  </svg>
</div>

<div class="side-deco side-right" aria-hidden="true">
  <svg viewBox="0 0 160 900" preserveAspectRatio="xMidYMin meet">
    <line class="sd-line" x1="138" y1="0" x2="138" y2="900" />
    <line class="sd-dash" x1="126" y1="0" x2="126" y2="900" />
    {Array.from({ length: 30 }, (_, i) => <line class="sd-tick" x1="138" x2={i % 5 ? 130 : 120} y1={i * 30 + 15} y2={i * 30 + 15} />)}
    <!-- Starburst sticker -->
    <g transform="translate(60 105) rotate(10)">
      <path class="sd-shadow" transform="translate(5 5)" d="M0 -46 L10 -30 L28 -38 L26 -18 L46 -14 L32 0 L46 14 L26 18 L28 38 L10 30 L0 46 L-10 30 L-28 38 L-26 18 L-46 14 L-32 0 L-46 -14 L-26 -18 L-28 -38 L-10 -30 Z" />
      <path class="sd-fill" fill="#6ea8fe" d="M0 -46 L10 -30 L28 -38 L26 -18 L46 -14 L32 0 L46 14 L26 18 L28 38 L10 30 L0 46 L-10 30 L-28 38 L-26 18 L-46 14 L-32 0 L-46 -14 L-26 -18 L-28 -38 L-10 -30 Z" />
      <text class="sd-text sd-big" y="6">NEAT!</text>
    </g>
    <!-- The site's motto, running down the side -->
    <text class="sd-motto" transform="translate(72 215) rotate(90)">BUILD ✦ PLAY ✦ COLLECT</text>
    <path class="sd-star" transform="translate(40 700) scale(1.1)" d={star} />
    <!-- Zigzag -->
    <path class="sd-line sd-thinline" d="M22 742 l 16 14 l 16 -14 l 16 14 l 16 -14 l 16 14" />
    <!-- A little box buddy, like the ones on the home page -->
    <g transform="translate(66 830) rotate(-6)">
      <rect class="sd-shadow" x="-30" y="-24" width="60" height="48" rx="7" transform="translate(4 4)" />
      <rect class="sd-fill" x="-30" y="-24" width="60" height="48" rx="7" fill="#5fd3a8" />
      <rect class="sd-fill" x="-34" y="-34" width="68" height="13" rx="5" fill="#5fd3a8" />
      <ellipse class="sd-eye" cx="-9" cy="-4" rx="5" ry="7" /><ellipse class="sd-eye" cx="9" cy="-4" rx="5" ry="7" />
      <circle class="sd-pupil" cx="-7" cy="-3" r="2.6" /><circle class="sd-pupil" cx="11" cy="-3" r="2.6" />
      <path class="sd-pupil" d="M -9 8 Q 0 10 9 8 Q 7 16 0 16 Q -7 16 -9 8 Z" />
    </g>
  </svg>
</div>

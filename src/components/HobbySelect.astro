---
// HobbySelect.astro: the "Retro" design's home-page hobby picker, styled like a game's
// character-select screen. Every hobby is a slot. Pointing at one (or tabbing to it)
// shows its info below; clicking goes to that hobby's page.
// A new hobby in src/data/site.ts shows up here by itself; it just needs a sprite in src/data/sprites.ts.
import { HOBBIES, type HobbyKey } from '../data/site';
import PixelSprite from './PixelSprite.astro';

const entries = Object.entries(HOBBIES) as [HobbyKey, (typeof HOBBIES)[HobbyKey]][];
const [firstKey, first] = entries[0];
---
<section class="select" aria-labelledby="select-title" id="select">
  <div class="select-head">
    <p class="select-kicker">Player 1</p>
    <h2 id="select-title">Select your hobby</h2>
  </div>

  <div class="select-grid">
    {entries.map(([key, h], i) => (
      <a class="slot" class:list={{ on: i === 0 }} href={`/${key}`} style={`--c:${h.color}`} data-name={h.name} data-blurb={h.blurb}>
        <span class="slot-cursor" aria-hidden="true">P1</span>
        <span class="slot-art"><PixelSprite name={key} size={64} /></span>
        <span class="slot-name">{h.name}</span>
      </a>
    ))}
  </div>

  <div class="select-info" aria-hidden="true">
    <PixelSprite name="sparkle" size={22} class="select-spark" />
    <div>
      <p class="select-info-name">{first.name}</p>
      <p class="select-info-blurb">{first.blurb}</p>
    </div>
    <a class="pixel-btn" href={`/${firstKey}`} tabindex="-1">Press start ▶</a>
  </div>
</section>

<script>
  // Point at a slot (mouse or keyboard) and the info box below shows that hobby.
  const select = document.querySelector('.select');
  if (select) {
    const nameEl = select.querySelector('.select-info-name');
    const blurbEl = select.querySelector('.select-info-blurb');
    const startEl = select.querySelector<HTMLAnchorElement>('.select-info .pixel-btn');
    const slots = select.querySelectorAll<HTMLAnchorElement>('.slot');
    const pick = (slot: HTMLAnchorElement) => {
      slots.forEach((s) => s.classList.toggle('on', s === slot));
      if (nameEl) nameEl.textContent = slot.dataset.name ?? '';
      if (blurbEl) blurbEl.textContent = slot.dataset.blurb ?? '';
      if (startEl) startEl.href = slot.getAttribute('href') ?? '/';
    };
    slots.forEach((slot) => {
      slot.addEventListener('mouseenter', () => pick(slot));
      slot.addEventListener('focus', () => pick(slot));
    });
  }
</script>

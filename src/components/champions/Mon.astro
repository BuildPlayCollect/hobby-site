---
// Mon.astro: one Pokémon as a small chip: icon, name, and a stripe in its type colours.
import { types, spriteUrl, displayName, TYPE_COLOURS } from '../../lib/pokemon';
interface Props { name: string; size?: 'sm' | 'md'; href?: string }
const { name, size = 'md', href } = Astro.props;
const Tag = href ? 'a' : 'span'; // with href, the chip links to that Pokémon's Pokédex page
const t = types(name);
const c1 = TYPE_COLOURS[t[0]] ?? '#ddd';
const c2 = TYPE_COLOURS[t[1] ?? t[0]] ?? c1;
const label = displayName(name);
const icon = spriteUrl(name);
---
<Tag href={href} class={`mon mon-${size}${icon ? '' : ' no-icon'}`} style={`--t1:${c1};--t2:${c2}`} title={t.length ? `${label} (${t.join(' / ')})` : label}>
  {icon && <img class="mon-icon" src={icon} alt="" width="40" height="40" loading="lazy" decoding="async" data-mon-icon />}
  <span class="mon-name">{label}</span>
</Tag>

<style is:global>
  /* Shared by every page that shows Pokémon chips (hub, learn, Pokédex). */
  .mon { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px 2px 2px; border-radius: 999px; background: linear-gradient(90deg, var(--t1) 0 50%, var(--t2) 50% 100%); border: 2px solid var(--line); color: #1b1a1f; font-weight: 700; font-size: .9rem; line-height: 1; white-space: nowrap; }
  .mon-icon { width: 38px; height: 38px; object-fit: contain; margin: -7px -1px -7px -2px; }
  .mon-icon.is-missing { display: none; }
  .mon:has(.is-missing), .mon.no-icon { padding-left: 10px; min-height: 30px; }
  .mon-sm { font-size: .78rem; padding-right: 8px; }
  .mon-sm .mon-icon { width: 30px; height: 30px; margin: -5px -1px -5px -1px; }
  .mon-sm:has(.is-missing), .mon-sm.no-icon { min-height: 24px; }
  a.mon { transition: transform .15s; }
  a.mon:hover { text-decoration: none; transform: translateY(-2px); }
</style>

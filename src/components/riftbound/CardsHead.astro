---
// The top of every Riftbound page: breadcrumbs (TCG › Riftbound › ...) and the Riftbound menu.
// The menu is a row of big tabs with little pictures, so it's hard to miss. The page you're on is filled in.
// On a phone it stays one row you can swipe sideways.
import { LEGENDS, BATTLEFIELDS, RB_HUB, RB_CARDS_URL } from '../../lib/riftbound';

interface Props { crumbs?: { label: string; href?: string }[] }
const { crumbs = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
// Simple line pictures (24×24) for each tab.
const ICON = {
  learn: 'M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21V5M8 7h7M8 11h5',
  sets: 'M12 3 3 8l9 5 9-5zM3 13l9 5 9-5M3 17.5l9 5 9-5',
  legends: 'M3 8l4 4 5-7 5 7 4-4-2 11H5zM5 21h14',
  fields: 'M4 21V4M4 4h12l-2 4 2 4H4',
  search: 'M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14zM16 16l5 5',
  deck: 'M8 3h10a2 2 0 0 1 2 2v12M5 7h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z',
};
const tabs = [
  { label: 'Learn to play', href: RB_HUB, icon: ICON.learn },
  { label: 'All sets', href: RB_CARDS_URL, icon: ICON.sets },
  { label: `Legends (${LEGENDS.length})`, href: '/tcg/riftbound/legends/', icon: ICON.legends },
  { label: `Battlefields (${BATTLEFIELDS.length})`, href: '/tcg/riftbound/battlefields/', icon: ICON.fields },
  { label: 'Search cards', href: '/tcg/riftbound/search/', icon: ICON.search },
  { label: 'Deck builder', href: '/tcg/riftbound/deck-builder/', icon: ICON.deck },
];
// "All sets" stays lit on every set list and card page too.
const isOn = (href: string) => path === href || (href === RB_CARDS_URL && path.startsWith(RB_CARDS_URL));
const all = [{ label: 'TCG', href: '/tcg/' }, { label: 'Riftbound', href: RB_HUB }, ...crumbs];
---
<div class="rb-head">
  <nav class="rb-crumbs" aria-label="Breadcrumb">
    {all.map((c, i) => <>{i > 0 && <span aria-hidden="true">›</span>}{c.href && i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current={i === all.length - 1 ? 'page' : undefined}>{c.label}</span>}</>)}
  </nav>
  <nav class="rb-tabs" aria-label="Riftbound">
    {tabs.map((t) => (
      <a href={t.href} aria-current={isOn(t.href) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icon} /></svg>
        {t.label}
      </a>
    ))}
  </nav>
</div>

<script>
  // On a phone the row is wider than the screen: slide it so the tab for this page is in view.
  for (const row of document.querySelectorAll<HTMLElement>('.rb-tabs')) {
    const on = row.querySelector<HTMLElement>('[aria-current="page"]');
    if (on && row.scrollWidth > row.clientWidth) row.scrollLeft = on.offsetLeft - (row.clientWidth - on.offsetWidth) / 2;
  }
</script>

<style>
  .rb-head { margin: 22px 0 24px; }
  .rb-crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: .85rem; color: var(--muted); margin: 0 0 12px; }
  .rb-tabs { position: relative; display: flex; gap: 6px; padding: 6px; border: 2px solid var(--line); border-radius: 18px; background: var(--surface); box-shadow: var(--lift); overflow-x: auto; scrollbar-width: none; }
  .rb-tabs::-webkit-scrollbar { display: none; }
  .rb-tabs a { flex: 1 0 auto; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 13px; font-weight: 800; font-size: .92rem; color: var(--ink); white-space: nowrap; transition: background .15s, color .15s; }
  .rb-tabs a svg { flex: none; opacity: .8; }
  .rb-tabs a:hover { text-decoration: none; background: var(--mark); color: #1b1a1f; }
  .rb-tabs a[aria-current='page'] { background: var(--c1); color: #fff; }
  .rb-tabs a[aria-current='page'] svg { opacity: 1; }
  /* The page title right under the menu doesn't need the usual big gap on top. */
  .rb-head + :global(.page-head) { padding-top: 8px; }
  @media (max-width: 600px) {
    .rb-head { margin: 16px 0 20px; }
    .rb-tabs { margin-inline: -6px; -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); padding-right: 30px; }
    .rb-tabs a { flex: none; padding: 0 12px; font-size: .88rem; }
    .rb-head + :global(.page-head) { padding-top: 4px; }
  }
  @media (prefers-reduced-motion: reduce) { .rb-tabs a { transition: none; } }
</style>

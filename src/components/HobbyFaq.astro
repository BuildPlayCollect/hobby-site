---
// HobbyFaq: the "Beginner questions" section on each hobby page.
// The questions live in src/content/faq/<hobby>.yml (editable in Pages CMS under "Hobby FAQs").
// Each one folds open with <details>, which needs no JavaScript.
import SourceList from './SourceList.astro';
import { faqHtml } from '../lib/faq-text';

interface Props { title: string; checked?: Date; questions: { question: string; answer: string; sources: { name: string; url: string }[] }[] }
const { title, checked, questions } = Astro.props;
const checkedWords = checked ? `Answers last checked ${checked.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}. ` : '';
const sources = questions.flatMap((q) => q.sources.map((s) => ({ url: s.url, label: s.name })));
// Show each source once, even when several answers use it.
const unique = sources.filter((s, i) => sources.findIndex((t) => t.url === s.url) === i);
---
{questions.length > 0 && (
  <section class="faq" aria-labelledby="faq-title">
    <div class="section-head"><h2 id="faq-title">{title} beginner questions</h2></div>
    <div class="faq-list">
      {questions.map((q) => (
        <details class="faq-item">
          <summary><span>{q.question}</span><span class="faq-plus" aria-hidden="true"></span></summary>
          <p set:html={faqHtml(q.answer)} />
        </details>
      ))}
    </div>
    {unique.length > 0 && <SourceList sources={unique} note={`${checkedWords}Spot something out of date? Tell us at hello@buildplaycollect.com.`} />}
  </section>
)}

<style>
  .faq-list { display: grid; gap: 10px; }
  .faq-item { border: 2px solid var(--line); border-radius: 16px; background: var(--surface); transition: transform .15s, box-shadow .15s; }
  .faq-item:hover { transform: translateY(-2px); }
  .faq-item summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 14px 18px; font-weight: 800; font-size: 1.05rem; line-height: 1.3; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { flex: none; display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--c1); color: #fff; font-size: 1.05rem; line-height: 1; transition: transform .2s; }
  .faq-plus::before { content: "+"; }
  .faq-item[open] .faq-plus { transform: rotate(45deg); }
  .faq-item p { margin: 0; padding: 0 18px 16px; color: var(--ink); line-height: 1.6; max-width: 72ch; }
  .faq-item p :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .faq :global(.src-box) { margin-top: 18px; }
  @media (prefers-reduced-motion: reduce) { .faq-item, .faq-plus { transition: none; } .faq-item:hover { transform: none; } }
</style>

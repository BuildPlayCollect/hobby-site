---
// KeyboardHero.astro: the "Keys" design's hobby picker at the top of the home page.
// A cluster of chunky 3D keycaps on blue graph paper. B, P and C spell the site's initials;
// every other key is a real link to a hobby, and the wide space bar opens the quiz.
// A little pointer wanders around pressing keys, and stops when you hover so you can press them yourself.
// A new hobby in src/data/site.ts shows up here by itself (it needs an icon in HobbyIcon.astro).
import { HOBBIES, type HobbyKey } from '../data/site';
import HobbyIcon from './HobbyIcon.astro';

const hobbies = Object.entries(HOBBIES) as [HobbyKey, (typeof HOBBIES)[HobbyKey]][];
// Three rows, each starting with one letter of B-P-C. Hobbies fill the rest in order.
const rows = [
  { letter: 'B', keys: hobbies.slice(0, 3) },
  { letter: 'P', keys: hobbies.slice(3, 6) },
  { letter: 'C', keys: hobbies.slice(6) },
];
// The pointer presses these three keys in turn (row, position in row).
const auto = ['1-2', '2-1', 'space'];
---
<div class="keys-panel">
  <p class="keys-note" aria-hidden="true">press a key :)</p>
  <nav class="keys" aria-label="Pick a hobby">
    {rows.map((row, r) => (
      <div class="keys-row" style={`--row:${r}`}>
        <span class="key key-letter" aria-hidden="true"><span class="key-face">{row.letter}</span></span>
        {row.keys.map(([key, h], i) => {
          const n = auto.indexOf(`${r}-${i + 1}`);
          return (
            <a class:list={['key', n >= 0 && `auto auto-${n + 1}`]} href={`/${key}`} style={`--c:${h.color}`} title={h.blurb}>
              <span class="key-face"><HobbyIcon hobby={key} size={34} /><span class="key-name">{h.name}</span></span>
            </a>
          );
        })}
        {r === 2 && (
          <a class="key key-space auto auto-3" href="/quiz">
            <span class="key-face"><span class="key-q">?</span> Not sure? <strong>Take the quiz</strong></span>
          </a>
        )}
      </div>
    ))}
    <svg class="pointer" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 3l20 13-9 2 5 10-4 2-5-10-7 6z" fill="#fbfaf7" stroke="#0c1825" stroke-width="2.2" stroke-linejoin="round" /></svg>
  </nav>
</div>

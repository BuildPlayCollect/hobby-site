---
// One Unmatched card: the real card picture when we have it saved, otherwise a card-shaped tile
// built from the card's details (type colour, value, boost, who can play it, and its text).
import type { UmCard } from '../../lib/unmatched-cards';

interface Props { card: UmCard; fighter: string }
const { card, fighter } = Astro.props;
const TYPE = { attack: 'Attack', defense: 'Defense', versatile: 'Versatile', scheme: 'Scheme' } as const;
const who = card.who === 'ANY' ? 'Any fighter' : card.who.toLowerCase().replace(/(^|[\s(&.-])\p{L}/gu, (m) => m.toUpperCase());
const parts = [
  card.text.basic && { label: '', text: card.text.basic },
  card.text.immediate && { label: 'Immediately', text: card.text.immediate },
  card.text.during && { label: 'During combat', text: card.text.during },
  card.text.after && { label: 'After combat', text: card.text.after },
].filter(Boolean) as { label: string; text: string }[];
const summary = [TYPE[card.type], card.value != null && `value ${card.value}`, card.boost != null && `boost ${card.boost}`, who].filter(Boolean).join(', ');
---
<li class={`umc umc-${card.type}`} id={`card-${card.slug}`}>
  {card.img ? (
    <img src={card.img} alt={`${card.title}: ${summary}. ${parts.map((p) => (p.label ? p.label + ': ' : '') + p.text).join(' ')}`} width="400" height="560" loading="lazy" decoding="async" />
  ) : (
    <div class="umc-face" role="img" aria-label={`${card.title} (${summary})`}>
      <div class="umc-top">
        <span class="umc-val">{card.value ?? ''}</span>
        <span class="umc-type">{TYPE[card.type]}</span>
      </div>
      <p class="umc-title">{card.title}</p>
      <p class="umc-who">{who}</p>
      <div class="umc-text">{parts.map((p) => <p>{p.label && <b>{p.label}: </b>}{p.text}</p>)}</div>
      {card.boost != null && <span class="umc-boost" title="Boost value">{card.boost}</span>}
    </div>
  )}
  {card.qty > 1 && <span class="umc-qty" aria-label={`${card.qty} copies`}>×{card.qty}</span>}
  <span class="sr-only">{fighter}'s deck</span>
</li>

<style>
  .umc { position: relative; list-style: none; scroll-margin-top: 90px; display: flex; flex-direction: column; }
  .umc > .umc-face { flex: 1; }
  .umc:target .umc-face, .umc:target img { outline: 4px solid var(--c2, var(--c1)); outline-offset: 3px; }
  .umc img { display: block; width: 100%; height: auto; border-radius: 12px; border: 2px solid var(--line); background: var(--surface-2); }
  .umc-attack { --tc: #e5484d; } .umc-defense { --tc: #3e7bd6; } .umc-versatile { --tc: #8b5cc9; } .umc-scheme { --tc: #e8b10f; }
  .umc-face { position: relative; display: flex; flex-direction: column; height: 100%; min-height: 250px; padding: 0 0 34px; border: 2px solid var(--line); border-radius: 12px; background: var(--surface); overflow: hidden; }
  .umc-top { display: flex; align-items: center; gap: 8px; padding: 6px 10px; background: var(--tc); color: #fff; }
  .umc-scheme .umc-top { color: #1b1a1f; }
  .umc-val { display: grid; place-items: center; min-width: 26px; height: 26px; border-radius: 50%; background: rgba(0, 0, 0, .25); font-family: var(--display); font-weight: 800; }
  .umc-val:empty { display: none; }
  .umc-type { font-size: .72rem; font-weight: 800; letter-spacing: .04em; }
  .umc-title { margin: 8px 10px 0; font-family: var(--display); font-weight: 800; font-size: .95rem; line-height: 1.2; }
  .umc-who { margin: 2px 10px 0; font-size: .72rem; font-weight: 700; color: var(--muted); }
  .umc-text { margin: 6px 10px 0; font-size: .74rem; line-height: 1.35; }
  .umc-text p { margin: 0 0 4px; }
  .umc-boost { position: absolute; left: 8px; bottom: 8px; display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 6px; background: var(--ink); color: var(--bg, #fff); font-size: .75rem; font-weight: 800; }
  .umc-boost::before { content: "Boost "; font-weight: 600; font-size: .65rem; margin-right: 3px; }
  .umc-qty { position: absolute; right: -6px; top: -8px; padding: 2px 8px; border-radius: 999px; border: 2px solid var(--line); background: var(--surface); font-size: .78rem; font-weight: 800; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

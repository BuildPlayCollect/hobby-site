---
// Doodle.astro: small hand-drawn marks (sparkles, scribbles, stars, a smiley) for the "Retro" design.
// Drawn here from simple paths, so they're ours to use anywhere.
interface Props {
  name: 'sparkle' | 'star' | 'scribble' | 'squiggle' | 'smile' | 'rays' | 'loop';
  size?: number;
  color?: string;
  class?: string;
}
const { name, size = 32, color = 'var(--yellow)', class: cls } = Astro.props;
const ink = 'var(--doodle-ink, #141414)';
---
<svg class:list={['doodle', `doodle-${name}`, cls]} width={size} height={size} viewBox="0 0 32 32" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'sparkle' && <path d="M16 2c1.4 8.4 5.2 12.4 14 14-8.8 1.6-12.6 5.6-14 14-1.4-8.4-5.2-12.4-14-14 8.8-1.6 12.6-5.6 14-14z" fill={color} stroke={ink} stroke-width="2" />}
  {name === 'star' && <path d="M16 3l3.8 8.6 9.2.9-7 6.2 2.1 9.1L16 23l-8.1 4.8 2.1-9.1-7-6.2 9.2-.9z" stroke={color} stroke-width="3" />}
  {name === 'scribble' && <path d="M3 26 9 5l5 21 5-21 5 21 5-21" stroke={ink} stroke-width="2.6" />}
  {name === 'squiggle' && <path d="M2 18c4-9 7-9 9 0s5 9 9 0 6-9 10 0" stroke={color} stroke-width="3.2" />}
  {name === 'smile' && (<><circle cx="16" cy="16" r="12.5" stroke={ink} stroke-width="2.4" /><path d="M11.5 12.5v2M20.5 12.5v2M10.5 19c3 4 8 4 11 0" stroke={ink} stroke-width="2.4" /></>)}
  {name === 'rays' && <path d="M6 6l7 6M3 16h9M6 26l7-6" stroke={ink} stroke-width="2.8" />}
  {name === 'loop' && <path d="M3 24c2-12 13-15 13-6 0 6-9 5-6-3 3-7 13-9 19-3" stroke={ink} stroke-width="2.6" />}
</svg>

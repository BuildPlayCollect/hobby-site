---
// HobbyIcon.astro: a small line icon for each hobby, drawn from basic shapes (ours to use).
import type { HobbyKey } from '../data/site';
interface Props { hobby: HobbyKey; size?: number }
const { hobby, size = 28 } = Astro.props;
---
<svg class="hobby-icon" width={size} height={size} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {hobby === 'beyblade' && (<><ellipse cx="16" cy="13" rx="12" ry="5" /><path d="M4 13l12 15 12-15" /><circle cx="16" cy="12" r="2" /></>)}
  {hobby === 'tamiya' && (<><path d="M3 20h26v-4l-5-1-3-5H11l-4 5-4 1z" /><circle cx="9" cy="21" r="3" /><circle cx="23" cy="21" r="3" /></>)}
  {hobby === 'keyboards' && (<><rect x="3" y="8" width="26" height="16" rx="3" /><path d="M8 13h2M14 13h2M20 13h2M10 18h12" /></>)}
  {hobby === 'tcg' && (<><rect x="9" y="4" width="15" height="21" rx="2" transform="rotate(12 16 14)" /><rect x="5" y="7" width="15" height="21" rx="2" /><path d="M12.5 13l1.5 3 3 .5-2.2 2 .6 3-2.9-1.5-2.9 1.5.6-3-2.2-2 3-.5z" /></>)}
  {hobby === 'consoles' && (<><path d="M9 10h14a6 6 0 0 1 6 6v2a4 4 0 0 1-7 2.5L20 19h-8l-2 1.5A4 4 0 0 1 3 18v-2a6 6 0 0 1 6-6z" /><path d="M9 14v4M7 16h4" /><circle cx="22" cy="15" r="1" /><circle cx="24" cy="18" r="1" /></>)}
  {hobby === 'esports' && (<><path d="M10 5h12v6a6 6 0 0 1-12 0z" /><path d="M10 7H5a5 5 0 0 0 5 6M22 7h5a5 5 0 0 1-5 6M16 17v5M11 27h10l-1-5h-8z" /></>)}
  {hobby === 'general' && (<><path d="M16 3l3.5 8.5L28 13l-6.5 6 1.8 9L16 23.5 8.7 28l1.8-9L4 13l8.5-1.5z" /></>)}
</svg>

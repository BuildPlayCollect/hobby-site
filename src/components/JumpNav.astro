---
// JumpNav: the "Jump to" menu at the top of long pages (learn-to-play pages, hubs, Pokédex pages...).
// - It sticks under the site header while you scroll, so the sections are always one tap away.
// - The section you're reading lights up, so you always know where you are.
// - On a phone it's one row you can swipe sideways, instead of a big pile of buttons.
// Links starting with "#" jump down this page. Any other link opens another page and gets a little arrow.
interface Props { links: { href: string; label: string }[]; label?: string }
const { links, label = 'Jump to' } = Astro.props;
---
<nav class="jump" aria-label="On this page" data-jump>
  <span class="jump-label">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
    {label}
  </span>
  <div class="jump-track" data-jump-track>
    {links.map((l) => <a href={l.href}>{l.label}{!l.href.startsWith('#') && <span aria-hidden="true"> →</span>}</a>)}
  </div>
</nav>

<script>
  // Light up the link for the section on screen, and slide the row so that link stays visible.
  for (const nav of document.querySelectorAll<HTMLElement>('[data-jump]')) {
    const track = nav.querySelector<HTMLElement>('[data-jump-track]')!;
    const links = [...track.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((t): t is HTMLElement => !!t);
    if (!targets.length) continue;
    const pick = () => {
      // The current section is the last one whose top has scrolled past the menu.
      const line = nav.getBoundingClientRect().bottom + 24;
      let cur: HTMLElement | null = null;
      for (const t of targets) if (t.getBoundingClientRect().top <= line) cur = t;
      // Back above the first section: slide the row back to the start.
      if (!cur && links.some((a) => a.hasAttribute('aria-current'))) track.scrollTo({ left: 0, behavior: 'smooth' });
      for (const a of links) {
        const on = !!cur && a.hash === `#${cur.id}`;
        if (on && a.getAttribute('aria-current') !== 'true') {
          a.setAttribute('aria-current', 'true');
          const left = a.offsetLeft - (track.clientWidth - a.offsetWidth) / 2;
          track.scrollTo({ left, behavior: 'smooth' });
        } else if (!on) a.removeAttribute('aria-current');
      }
    };
    let queued = false;
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; pick(); }); } }, { passive: true });
    pick();
  }
</script>

<style>
  .jump { position: sticky; top: calc(var(--header-h) + 8px); z-index: 40; display: flex; align-items: center; gap: 4px; margin: 8px 0 28px; padding: 6px; border: 2px solid var(--line); border-radius: 18px; background: var(--surface); box-shadow: var(--lift); }
  .jump-label { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 0 10px 0 8px; font-size: .78rem; font-weight: 800; color: var(--muted); white-space: nowrap; border-right: 2px solid var(--line); }
  .jump-track { position: relative; display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; scroll-padding-inline: 12px; -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); padding-right: 24px; }
  .jump-track::-webkit-scrollbar { display: none; }
  .jump-track a { flex: none; display: inline-flex; align-items: center; min-height: 38px; padding: 0 14px; border-radius: 999px; font-weight: 700; font-size: .9rem; color: var(--ink); white-space: nowrap; transition: background .15s, color .15s; }
  .jump-track a:hover { text-decoration: none; background: var(--mark); color: #1b1a1f; }
  .jump-track a[aria-current='true'] { background: var(--c1); color: #fff; }
  .jump-track a:focus-visible { outline: 3px solid var(--c2); outline-offset: -3px; }
  /* Jumping to a section shouldn't hide its heading under the header and this menu. */
  :global(html:has(.jump)) { scroll-padding-top: calc(var(--header-h) + 84px); }
  @media (max-width: 600px) {
    .jump { margin-inline: -6px; border-radius: 16px; }
    .jump-label { padding: 0 8px 0 6px; font-size: 0; gap: 0; }
    .jump-label svg { width: 18px; height: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .jump-track a { transition: none; } }
</style>

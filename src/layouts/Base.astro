---
// Base.astro: the frame around every page (header, menu, search, footer).
// Each page puts its own content where <slot /> is.
import { getCollection } from 'astro:content';
import { SITE_NAME, SITE_TAGLINE, HOBBIES, TYPE_SLUGS } from '../data/site';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
// Inter font, stored on our own site (no Google Fonts request).
import '@fontsource-variable/inter';
// The two main font files, fetched early (before the page needs them) so text shows in the right font straight away.
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import headlineFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
// The whole look of the site (colours, fonts, outlines, shadows) lives in ONE theme file.
// To try a different design, point this line at another file in src/styles/themes/.
import '../styles/themes/blend.css';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title?: string;
  description?: string;
  // SEO extras: a share image (e.g. an article's cover), the page kind, and structured data for Google.
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}
const { title, description = SITE_TAGLINE, image, type = 'website', jsonLd } = Astro.props;
// The newsletter page already is the sign-up form, so it skips the strip above the footer.
const showNewsletter = !Astro.url.pathname.startsWith('/newsletter');
// Giveaways only shows in the menu once a giveaway article is live, so the link never opens an empty page.
const hasGiveaways = (await getCollection('articles', ({ data }) => !data.draft && data.type === 'giveaway')).length > 0;
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
// The one official address for this page, so Google doesn't count www/workers.dev copies as duplicates.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The picture shown when the page is shared on Facebook, Messenger, X, Discord...
const shareImage = new URL(image ?? '/share-preview-v2.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Tab icon, and "Add to Home Screen" on phones: the manifest gives the shortcut its name, icon and colour. -->
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#4b607f" />
    <meta name="apple-mobile-web-app-title" content="BPC" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headlineFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Night mode: runs before the page draws so it never flashes white.
         Uses the reader's saved choice, or their device's setting if they haven't picked. -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        // Add ?photos to an article's address to see where photos still need to go.
        if (/[?&]photos\b/.test(location.search)) document.documentElement.classList.add('show-photo-slots');
        // Colour theme: the reader picks one with the palette button (remembered on this device).
        // ?colorway=playtime in the address also works, handy for sharing a look.
        var themes = ['retro', 'playtime', 'curious', 'fresh', 'arcade', 'ocean', 'berry', 'ink'];
        var cw = (location.search.match(/[?&]colorway=(\w+)/) || [])[1];
        try { if (cw) localStorage.setItem('colorway', cw); else cw = localStorage.getItem('colorway'); } catch (e) {}
        document.documentElement.dataset.colorway = themes.indexOf(cw) > -1 ? cw : 'retro';
      })();
    </script>
  </head>
  <body>
    <!-- Dateline: a thin strip above the header, like the top of a newspaper -->
    <div class="dateline">
      <div class="wrap">
        <span data-today>History, guides and news for every hobby</span>
        <span class="dateline-links"><a href="/standards">Fact-checked</a><a href="/newsletter">Newsletter</a><a href="/about">About</a></span>
      </div>
    </div>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="logo" href="/"><span class="logo-mark" aria-hidden="true">BPC</span>{SITE_NAME}</a>

        <nav class="main-nav" id="main-nav" aria-label="Main">
          <div class="dropdown">
            <button class="nav-button" type="button" aria-expanded="false" aria-controls="hobby-menu">
              Hobbies <span class="chev" aria-hidden="true">▼</span>
            </button>
            <div class="dropdown-panel" id="hobby-menu">
              <div class="dropdown-inner">
                {Object.entries(HOBBIES).map(([key, h]) => (
                  <a class="hobby-item" href={`/${key}`} style={`--c:${h.color}`}>
                    <span class="dot" style={`background:${h.color}`}></span>
                    <span><strong>{h.name}</strong><small>{h.blurb}</small></span>
                  </a>
                ))}
              </div>
            </div>
          </div>
          <a class="nav-link" href={`/${TYPE_SLUGS.guide}`}>Guides</a>
          <a class="nav-link" href={`/${TYPE_SLUGS['new-release']}`}>New Releases</a>
          <a class="nav-link" href="/wiki">Wiki</a>
          <a class="nav-link" href="/rules">Rules</a>
          {hasGiveaways && <a class="nav-link" href={`/${TYPE_SLUGS.giveaway}`}>Giveaways</a>}
        </nav>

        <div class="header-actions">
          <button class="icon-btn search-open" type="button" aria-label="Search (press /)" title="Search (press /)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
          <div class="palette">
            <button class="icon-btn palette-toggle" type="button" aria-label="Colour theme" title="Colour theme" aria-expanded="false" aria-controls="palette-panel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.8 1.8-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.7-1.7H16a5 5 0 0 0 5-5c0-4-4-7.2-9-7.2Z"/><circle cx="7.5" cy="11" r="1.2" fill="currentColor"/><circle cx="10.5" cy="7.2" r="1.2" fill="currentColor"/><circle cx="15" cy="7.8" r="1.2" fill="currentColor"/></svg></button>
            <div class="palette-panel" id="palette-panel" role="group" aria-label="Pick a colour theme">
              <p class="palette-title">Pick a colour theme</p>
              <ul class="palette-list">
                {[
                  { id: 'retro', name: 'Retro', note: 'Cosy and classic', c: ['#4b607f', '#f3701e', '#e8d8c9'] },
                  { id: 'playtime', name: 'Playtime', note: 'Bright and friendly', c: ['#2f5bd3', '#ffc93c', '#dfe7fb'] },
                  { id: 'curious', name: 'Curious', note: 'Creative and bold', c: ['#6c4ab6', '#ffb547', '#e9e1fb'] },
                  { id: 'fresh', name: 'Fresh', note: 'Calm and new', c: ['#1f7a5a', '#a8db6a', '#e1f1e3'] },
                  { id: 'arcade', name: 'Arcade', note: 'Neon game night', c: ['#c2185b', '#3ccfe0', '#fbe3ee'] },
                  { id: 'ocean', name: 'Ocean', note: 'Cool and sunny', c: ['#0f6e7a', '#ff8a65', '#dcefef'] },
                  { id: 'berry', name: 'Berry', note: 'Sweet and fun', c: ['#8e2a5c', '#7fd8be', '#f6e3ec'] },
                  { id: 'ink', name: 'Ink', note: 'Comic-book classic', c: ['#26262e', '#ffd23f', '#ecebe6'] },
                ].map((t) => (
                  <li>
                    <button class="palette-option" type="button" data-colorway-pick={t.id} aria-pressed="false">
                      <span class="palette-dots" aria-hidden="true">{t.c.map((c) => <i style={`background:${c}`}></i>)}</span>
                      <span class="palette-name">{t.name}<small>{t.note}</small></span>
                    </button>
                  </li>
                ))}
              </ul>
              <p class="palette-foot">Light or dark? Use the button next to this one.</p>
            </div>
          </div>
          <button class="icon-btn theme-toggle" type="button" aria-label="Toggle night mode" title="Toggle night mode">
            <span class="sun">☀</span><span class="moon">☾</span>
          </button>
          <button class="icon-btn menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="main-nav">☰</button>
        </div>
      </div>
    </header>

    <div class="search-overlay" role="dialog" aria-modal="false" aria-label="Search">
      <div class="search-box">
        <label class="sr-only" for="search-input">Search articles and wiki</label>
        <input id="search-input" type="search" placeholder="Search" autocomplete="off" spellcheck="false" autocorrect="off" autocapitalize="off" />
        <ul class="search-results"></ul>
        <p class="search-hint">Try "Bit", "switch" or "Tamiya".<span class="search-hint-keys"> Press Esc to close.</span></p>
      </div>
    </div>

    <div class="wrap"><AdSlot position="header" /></div>
    <main class="wrap">
      <slot />
    </main>
    {showNewsletter && <div class="wrap"><Newsletter compact /></div>}

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a class="logo" href="/"><span class="logo-mark" aria-hidden="true">BPC</span>{SITE_NAME}</a>
          <p>{SITE_TAGLINE}</p>
        </div>
        <div>
          <h2>Hobbies</h2>
          <ul>{Object.entries(HOBBIES).map(([key, h]) => <li><a href={`/${key}`}>{h.name}</a></li>)}</ul>
        </div>
        <div>
          <h2>Site</h2>
          <ul>
            <li><a href="/quiz">Which hobby fits you?</a></li>
            <li><a href="/wiki">Wiki</a></li>
            <li><a href="/rules">Tournament rules</a></li>
            <li><a href="/standards">Editorial standards</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/newsletter">Newsletter</a></li>
            <li><a href="/advertise">Advertise</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/privacy">Privacy</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap">
        <p class="footer-word" aria-hidden="true">Build Play Collect</p>
        <p class="footer-note">{SITE_NAME} is an independent fan site. We're not affiliated with or endorsed by the brands, publishers, game makers or leagues we write about (yet!). Names, logos, game art and card images belong to their owners and are shown to help fans learn. If you own something here and want it credited differently or taken down, <a href="/contact">tell us</a> and we'll sort it out quickly.</p>
        <div class="footer-base"><span>&copy; {new Date().getFullYear()} {SITE_NAME}</span><span>History · Guides · News{hasGiveaways && ' · Giveaways'}</span></div>
      </div>
    </footer>

    <Lightbox />

    <script>
      (function () {
        var root = document.documentElement;

        // Dateline: show the reader's date, like the top of a newspaper.
        var today = document.querySelector('[data-today]');
        if (today) today.textContent = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

        // Colour theme picker (the palette button): swap the colours and remember the choice.
        var palette = document.querySelector('.palette');
        var paletteBtn = palette.querySelector('.palette-toggle');
        var picks = palette.querySelectorAll('[data-colorway-pick]');
        function markPick() {
          picks.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.colorwayPick === root.dataset.colorway)); });
        }
        function closePalette() { palette.classList.remove('open'); paletteBtn.setAttribute('aria-expanded', 'false'); }
        markPick();
        paletteBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = palette.classList.toggle('open');
          paletteBtn.setAttribute('aria-expanded', String(open));
        });
        picks.forEach(function (b) {
          b.addEventListener('click', function () {
            root.dataset.colorway = b.dataset.colorwayPick;
            try { localStorage.setItem('colorway', b.dataset.colorwayPick); } catch (e) {}
            markPick();
          });
        });
        document.addEventListener('click', function (e) { if (!palette.contains(e.target)) closePalette(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePalette(); });

        // Night mode button: flip the theme and remember the choice.
        document.querySelector('.theme-toggle').addEventListener('click', function () {
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });

        // Phone menu (the ☰ button).
        var menuBtn = document.querySelector('.menu-toggle');
        menuBtn.addEventListener('click', function () {
          var open = document.body.classList.toggle('nav-open');
          menuBtn.setAttribute('aria-expanded', open);
          menuBtn.textContent = open ? '✕' : '☰';
        });

        // Hobbies dropdown: click to open, hover on desktop, click outside or Esc to close.
        var dropdown = document.querySelector('.dropdown');
        var ddBtn = dropdown.querySelector('.nav-button');
        function setDropdown(open) { dropdown.classList.toggle('open', open); ddBtn.setAttribute('aria-expanded', open); }
        ddBtn.addEventListener('click', function () { setDropdown(!dropdown.classList.contains('open')); });
        if (window.matchMedia('(hover: hover) and (min-width: 881px)').matches) {
          var t;
          dropdown.addEventListener('mouseenter', function () { clearTimeout(t); setDropdown(true); });
          dropdown.addEventListener('mouseleave', function () { t = setTimeout(function () { setDropdown(false); }, 150); });
        }
        document.addEventListener('click', function (e) { if (!dropdown.contains(e.target)) setDropdown(false); });

        // Search: opens with the ⌕ button or the "/" key, searches /search.json.
        var overlay = document.querySelector('.search-overlay');
        var input = document.getElementById('search-input');
        var list = overlay.querySelector('.search-results');
        var index = null, active = -1;
        function openSearch() {
          overlay.classList.add('open'); input.value = ''; render([]); input.focus();
          if (!index) fetch('/search.json').then(function (r) { return r.json(); }).then(function (d) { index = d; search(); });
        }
        function closeSearch() { overlay.classList.remove('open'); }
        function render(items) {
          active = -1;
          list.innerHTML = items.slice(0, 12).map(function (it) {
            return '<li><a href="' + escapeHtml(it.url) + '"><span class="kind ' + (it.kind === 'Wiki' ? 'wiki-kind' : '') + '">' + escapeHtml(it.kind) + ' · ' + escapeHtml(it.hobby) + '</span><br>' +
              escapeHtml(it.title) + '<small>' + escapeHtml(it.summary) + '</small></a></li>';
          }).join('');
        }
        function escapeHtml(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
        // Accents are ignored, so "pokemon" finds "Pokémon" and "flabebe" finds "Flabébé".
        function fold(s) { return String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }
        // Best matches first: a title that starts with what you typed, then a title that contains it, then the rest.
        function search() {
          var q = fold(input.value.trim());
          if (!q || !index) return render([]);
          var words = q.split(/\s+/);
          var hits = [];
          index.forEach(function (it, i) {
            var title = fold(it.title);
            var hay = title + ' ' + fold(it.summary + ' ' + it.hobby + ' ' + it.kind);
            if (!words.every(function (w) { return hay.indexOf(w) !== -1; })) return;
            var score = title.indexOf(q) === 0 ? 0 : title.indexOf(q) !== -1 ? 1 : words.every(function (w) { return title.indexOf(w) !== -1; }) ? 2 : 3;
            hits.push({ it: it, score: score, i: i });
          });
          hits.sort(function (a, b) { return a.score - b.score || a.i - b.i; });
          render(hits.map(function (h) { return h.it; }));
        }
        input.addEventListener('input', search);
        input.addEventListener('keydown', function (e) {
          var links = list.querySelectorAll('a');
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            active = Math.max(0, Math.min(links.length - 1, active + (e.key === 'ArrowDown' ? 1 : -1)));
            links.forEach(function (l, i) { l.classList.toggle('active', i === active); });
          } else if (e.key === 'Enter' && links[Math.max(active, 0)]) {
            location.href = links[Math.max(active, 0)].href;
          }
        });
        document.querySelectorAll('.search-open, [data-open-search]').forEach(function (b) { b.addEventListener('click', openSearch); });
        // The search is a panel over the page, so a click anywhere outside the box closes it.
        document.addEventListener('click', function (e) {
          if (!overlay.classList.contains('open') || e.target.closest('.search-box, .search-open, [data-open-search]')) return;
          closeSearch();
        });
        document.addEventListener('keydown', function (e) {
          var typing = /INPUT|TEXTAREA/.test(document.activeElement.tagName);
          if (e.key === '/' && !typing) { e.preventDefault(); openSearch(); }
          if (e.key === 'Escape') { closeSearch(); setDropdown(false); }
        });

        // Wiki previews: hovering a wiki word in an article shows its short definition.
        var links = document.querySelectorAll('a.wiki-link');
        if (links.length && window.matchMedia('(hover: hover)').matches) {
          var tip = document.createElement('div');
          tip.className = 'wiki-preview';
          tip.setAttribute('role', 'tooltip');
          document.body.appendChild(tip);
          links.forEach(function (a) {
            function show() {
              tip.innerHTML = '<strong></strong><p style="margin:0"></p><span>Click to open the wiki page</span>';
              tip.querySelector('strong').textContent = a.dataset.wikiTitle;
              tip.querySelector('p').textContent = a.dataset.wikiSummary;
              var r = a.getBoundingClientRect();
              var left = Math.min(window.scrollX + r.left, window.scrollX + document.documentElement.clientWidth - tip.offsetWidth - 12);
              tip.style.left = Math.max(12, left) + 'px';
              tip.style.top = (window.scrollY + r.bottom + 8) + 'px';
              tip.classList.add('show');
            }
            function hide() { tip.classList.remove('show'); }
            a.addEventListener('mouseenter', show); a.addEventListener('focus', show);
            a.addEventListener('mouseleave', hide); a.addEventListener('blur', hide);
          });
        }
      })();
    </script>
  </body>
</html>

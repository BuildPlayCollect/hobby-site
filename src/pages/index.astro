---
// index.astro: the home page (the address "/").
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Carousel from '../components/Carousel.astro';
import BoxHero from '../components/BoxHero.astro';
import HobbyIcon from '../components/HobbyIcon.astro';
import WikiUpdates from '../components/WikiUpdates.astro';
import NewsRoundup from '../components/NewsRoundup.astro';
import { HOBBIES, type HobbyKey } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// News roundups (written by the Mon/Thu update, named news-roundup-DATE) get their own section,
// so they never crowd the stories below.
const roundups = articles.filter((a) => a.id.startsWith('news-roundup-'));
const stories = articles.filter((a) => !roundups.includes(a));
const featured = stories.find((a) => a.data.featured);
// Top stories carousel: the featured story (if one is switched on), the newest story,
// then the newest story from each hobby. Capped at 6 so it never floods.
// It rebuilds itself every time an article is added, no editing needed.
const headlines = [featured, stories[0], ...Object.keys(HOBBIES).map((key) => stories.find((a) => a.data.hobby === key))]
  .filter((a, i, all) => a && all.indexOf(a) === i)
  .slice(0, 6) as typeof stories;
// Everything else that's new goes in "Fresh off the press", newest first, at most 6.
const latest = stories.filter((a) => !headlines.includes(a)).slice(0, 6);
const wiki = (await getCollection('wiki')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const rulebooks = (await getCollection('rules')).length;

// "Try one now" opens a random article that has a 60-second version (any live article if none do yet).
// The link points at the newest headline first, so it still works if scripts are off.
const withQuick = articles.filter((a) => a.data.quick?.length);
const tryUrls = (withQuick.length ? withQuick : articles).map((a) => `/articles/${a.id}/`);

// "New here?" steps for first-time visitors.
const steps = [
  { title: 'Pick a hobby', text: 'Open a box at the top. Every hobby has its own page of stories, guides and history.', href: '#hobby-boxes', link: 'Back to the boxes ↑', c: 'var(--blue)' },
  { title: 'Read the 60-second version', text: 'Every article opens with a short summary, so you get the gist before the deep dive.', href: headlines[0] ? `/articles/${headlines[0].id}/` : '/guides', link: 'Try one now →', c: 'var(--orange)', random: true },
  { title: 'Fall down the rabbit hole', text: 'Hobby words are linked to our wiki. Hover for a quick meaning, click to keep going.', href: '/wiki', link: 'Open the wiki →', c: 'var(--teal)' },
];
---
<Base>
  <!-- The top of the page: the site name and intro on the left, the box pile on the right. -->
  <BoxHero>
    <h1 class="big-title">Build.<br /><span class="hl">Play.</span><br />Collect.</h1>
    <p>Nerdy, playful and fact-checked. History, guides, new releases and giveaways for every hobby, from spinning tops to trading cards.</p>
    <!-- Live counts, as tilted stickers. They update themselves as hobbies, wiki words and rulebooks are added. -->
    <dl class="stat-stickers">
      <div><dt>Hobbies</dt><dd>{Object.keys(HOBBIES).length}</dd></div>
      <div><dt>Wiki words</dt><dd>{wiki.length}</dd></div>
      <div><dt>Rulebooks</dt><dd>{rulebooks}</dd></div>
    </dl>
    <a class="pill-btn" href="/wiki">Fall down the wiki →</a>
  </BoxHero>

  <!-- Phones only: a swipeable row of hobby buttons under the boxes, for quick tapping.
       Hidden on bigger screens, where the boxes do the job. -->
  <nav class="hobby-pills" aria-label="Hobbies">
    {Object.entries(HOBBIES).map(([key, h]) => (
      <a class="hobby-pill" href={`/${key}`} style={`background:${h.color}`}>
        <HobbyIcon hobby={key as HobbyKey} />
        <span>{h.name}</span>
      </a>
    ))}
  </nav>

  <!-- News roundup: the latest Mon/Thu roundup, on its own so it doesn't crowd the stories. -->
  <NewsRoundup roundups={roundups} />

  <!-- Fresh from the wiki: the newest added or updated wiki terms, so returning readers see what changed. -->
  <WikiUpdates />

  <!-- New here? Three numbered steps for first-time visitors. -->
  <section class="steps-wrap" aria-labelledby="steps-title">
    <div class="section-head"><h2 id="steps-title">New <span class="hl">here?</span></h2></div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="tile step" style={`--c:${s.c}`}>
          <span class="step-num">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <a class="step-link" href={s.href} data-random={s.random ? JSON.stringify(tryUrls) : undefined}>{s.link}</a>
        </li>
      ))}
    </ol>
  </section>

  <a class="tile tile-colour quiz-cta" href="/quiz">
    <div>
      <h2>Not sure where to start?</h2>
      <p>Take the 5-question quiz and find the hobby that fits you.</p>
    </div>
    <span class="pill-btn dark">Take the quiz →</span>
  </a>

  <div class="section-head"><h2>Top <span class="hl">stories</span></h2></div>
  <Carousel label="Top headlines" variant="hero" autoplay>
    {headlines.map((a) => <ArticleCard article={a} large />)}
  </Carousel>

  {latest.length > 0 && (
    <>
      <div class="section-head"><h2>Fresh off the press</h2></div>
      <div class="grid">{latest.map((a) => <ArticleCard article={a} />)}</div>
    </>
  )}

  <div class="section-head">
    <h2>Fall down the rabbit hole</h2>
    <a class="more" href="/wiki">Open the wiki →</a>
  </div>
  <div class="chip-row" style="flex-wrap:wrap;overflow:visible">
    {wiki.map((w) => <a class="chip wiki-chip" href={`/wiki/${w.id}/`}>{w.data.title}</a>)}
  </div>

  {Object.entries(HOBBIES).map(([key, h]) => {
    // A hobby gets its own row once it has 3+ articles. Before that, its stories
    // already show in Top stories, so a row would only repeat them.
    const forHobby = stories.filter((a) => a.data.hobby === key).slice(0, 8);
    return forHobby.length >= 3 && (
      <section>
        <div class="section-head">
          <h2><span class="dot" style={`background:${h.color};margin:0`}></span>{h.name}</h2>
          <a class="more" href={`/${key}`}>All {h.name} →</a>
        </div>
        <Carousel label={`Latest ${h.name}`}>
          {forHobby.map((a) => <ArticleCard article={a} />)}
        </Carousel>
      </section>
    );
  })}
</Base>

<script>
  // "Try one now": swap in a random article just before the link is followed.
  document.querySelectorAll<HTMLAnchorElement>('a[data-random]').forEach((a) => {
    const urls: string[] = JSON.parse(a.dataset.random || '[]');
    const pick = () => { if (urls.length) a.href = urls[Math.floor(Math.random() * urls.length)]; };
    a.addEventListener('pointerdown', pick);
    a.addEventListener('keydown', (e) => { if (e.key === 'Enter') pick(); });
  });
</script>

---
// index.astro: the home page (the address "/").
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Carousel from '../components/Carousel.astro';
import Sticker from '../components/Sticker.astro';
import HobbyIcon from '../components/HobbyIcon.astro';
import HobbyIsland from '../components/HobbyIsland.astro';
import { HOBBIES, type HobbyKey } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = articles.find((a) => a.data.featured) ?? articles[0];
// Headline carousel: the featured story, then the newest story from each hobby.
// It rebuilds itself every time an article is added, no editing needed.
const headlines = [featured, ...Object.keys(HOBBIES).map((key) => articles.find((a) => a.data.hobby === key))]
  .filter((a, i, all) => a && all.indexOf(a) === i);
const latest = articles.filter((a) => !headlines.includes(a)).slice(0, 6);
const wiki = (await getCollection('wiki')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Base>
  <HobbyIsland />

  <!-- Below the island: comic-panel tiles (a "bento" grid). -->
  <section class="bento">
    <div class="tile bento-title">
      <h1>Build.<br /><span class="hl">Play.</span><br />Collect.</h1>
      <Sticker text="ALL HOBBIES" color="var(--teal)" size={118} tilt={12} />
    </div>
    <div class="tile bento-intro">
      <p class="big">Nerdy.<br />Playful.<br />Fact-checked.</p>
      <hr />
      <p>History, guides, new releases and giveaways for the hobbies we love, from spinning tops to trading cards. Every fact is sourced.</p>
      <a class="pill-btn" href="/wiki">Fall down the wiki →</a>
    </div>
  </section>

  <nav class="hobby-pills" aria-label="Hobbies">
    {Object.entries(HOBBIES).map(([key, h]) => (
      <a class="hobby-pill" href={`/${key}`} style={`background:${h.color}`}>
        <HobbyIcon hobby={key as HobbyKey} />
        <span>{h.name}</span>
      </a>
    ))}
  </nav>

  <div class="section-head"><h2>Top <span class="hl">stories</span></h2></div>
  <Carousel label="Top headlines" variant="hero" autoplay>
    {headlines.map((a) => <ArticleCard article={a} large />)}
  </Carousel>

  {latest.length > 0 && (
    <>
      <div class="section-head"><h2>Fresh off the press</h2></div>
      <div class="grid">{latest.map((a) => <ArticleCard article={a} />)}</div>
    </>
  )}

  <div class="section-head">
    <h2>Fall down the rabbit hole</h2>
    <a class="more" href="/wiki">Open the wiki →</a>
  </div>
  <div class="chip-row" style="flex-wrap:wrap;overflow:visible">
    {wiki.map((w) => <a class="chip wiki-chip" href={`/wiki/${w.id}/`}>{w.data.title}</a>)}
  </div>

  {Object.entries(HOBBIES).map(([key, h]) => {
    const forHobby = articles.filter((a) => a.data.hobby === key).slice(0, 8);
    return forHobby.length > 0 && (
      <section>
        <div class="section-head">
          <h2><span class="dot" style={`background:${h.color};margin:0`}></span>{h.name}</h2>
          <a class="more" href={`/${key}`}>All {h.name} →</a>
        </div>
        <Carousel label={`Latest ${h.name}`}>
          {forHobby.map((a) => <ArticleCard article={a} />)}
        </Carousel>
      </section>
    );
  })}
</Base>

---
// index.astro: the home page (the address "/").
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HobbyIcon from '../components/HobbyIcon.astro';
import { HOBBIES, TYPES, type HobbyKey, type TypeKey } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// News roundups (written by the Mon/Thu update, named news-roundup-DATE) get their own section,
// so they never crowd the stories below.
const roundups = articles.filter((a) => a.id.startsWith('news-roundup-'));
const stories = articles.filter((a) => !roundups.includes(a));
const featured = stories.find((a) => a.data.featured);
// Top stories: the featured story (if one is switched on), the newest story,
// then the newest story from each hobby. Capped at 6 so it never floods.
// The first one is the big lead story; the rest go in the numbered list beside it.
// It rebuilds itself every time an article is added, no editing needed.
const headlines = [featured, stories[0], ...Object.keys(HOBBIES).map((key) => stories.find((a) => a.data.hobby === key))]
  .filter((a, i, all) => a && all.indexOf(a) === i)
  .slice(0, 6) as typeof stories;
// Everything else that's new goes in "Fresh off the press", newest first, at most 6.
const latest = stories.filter((a) => !headlines.includes(a)).slice(0, 6);
const wiki = (await getCollection('wiki')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const rulebooks = (await getCollection('rules')).length;

// "Try one now" opens a random article that has a 60-second version (any live article if none do yet).
// The link points at the newest headline first, so it still works if scripts are off.
const withQuick = articles.filter((a) => a.data.quick?.length);
const tryUrls = (withQuick.length ? withQuick : articles).map((a) => `/articles/${a.id}/`);

// Short, plain words for each hobby on the picker.
const nick: Record<string, string> = {
  beyblade: 'Spinning tops', tamiya: 'Tiny fast cars', keyboards: 'Clacky boards', tcg: 'Card battles',
  consoles: 'Game machines', esports: 'Pro gaming', general: 'Hobbies in general',
};
const picks = headlines.slice(0, 3);
// Rabbit hole: every wiki word, so the box can show a new one each visit (and on "Another word").
const holeWords = wiki.map((w) => ({ t: w.data.title, s: w.data.summary, u: `/wiki/${w.id}/`, h: HOBBIES[w.data.hobby as HobbyKey].name }));
const firstWord = holeWords[0];
const newest = roundups[0];
---
<Base>
  <!-- Welcome: a short hello, then one question with one big button per hobby. -->
  <section class="welcome" aria-labelledby="welcome-title">
    <h1 id="welcome-title">Find your next <span class="hl">hobby.</span></h1>
    <p>Fun, fact-checked stories about spinning tops, tiny cars, clacky keyboards, cards, consoles and esports.</p>
    <p class="welcome-ask">What are you into?</p>
    <ul class="picker">
      {Object.entries(HOBBIES).filter(([key]) => key !== 'general').map(([key, h]) => (
        <li>
          <a href={`/${key}`} style={`--c:${h.color}`}>
            <span class="picker-icon"><HobbyIcon hobby={key as HobbyKey} size={38} /></span>
            <strong>{h.name}</strong>
            <small>{nick[key]}</small>
          </a>
        </li>
      ))}
      <li>
        <a href="/quiz" style="--c:#ffffff">
          <span class="picker-icon" aria-hidden="true"><strong>?</strong></span>
          <strong>Not sure yet?</strong>
          <small>Take the quiz</small>
        </a>
      </li>
    </ul>
    <button class="welcome-search" type="button" data-open-search>Or search everything <kbd>/</kbd></button>
  </section>

  <!-- This week: one line with the newest Mon/Thu news roundup. -->
  {newest && (
    <a class="this-week" href={`/articles/${newest.id}/`}>
      <b>This week</b>
      <span>{newest.data.title}</span>
      <i>Read →</i>
    </a>
  )}

  <!-- Just three stories to start with. Everything else is one click away. -->
  {picks.length > 0 && (
    <>
      <div class="section-head"><h2>Start with a <span class="hl">story</span></h2><a class="more" href="/guides">All guides →</a></div>
      <div class="grid">{picks.map((a) => <ArticleCard article={a} />)}</div>
    </>
  )}

  <!-- Rabbit hole: one wiki word at a time. Readers choose to keep falling. -->
  {firstWord && (
    <>
      <div class="section-head"><h2>Rabbit hole of the day</h2><a class="more" href="/wiki">Whole wiki →</a></div>
      <div class="hole" data-hole={JSON.stringify(holeWords)}>
        <svg class="hole-art" viewBox="0 0 110 110" aria-hidden="true">
          <circle class="h1" cx="55" cy="55" r="50" /><circle class="h2" cx="55" cy="55" r="36" /><circle cx="55" cy="55" r="24" /><circle class="h3" cx="55" cy="55" r="13" />
        </svg>
        <div class="hole-word">
          <span class="label" data-hole-hobby>{firstWord.h}</span>
          <h3><a href={firstWord.u} data-hole-link>{firstWord.t}</a></h3>
          <p data-hole-text>{firstWord.s}</p>
        </div>
        <div class="hole-actions">
          <a class="pill-btn" href={firstWord.u} data-hole-go>Fall in →</a>
          <button class="hole-next" type="button" data-hole-next>Another word</button>
        </div>
      </div>
    </>
  )}

  <!-- Little games -->
  <div class="section-head"><h2>Take a break</h2></div>
  <div class="play2">
    <a href="/quiz" style="--c:var(--yellow)">
      <span class="play2-emoji" aria-hidden="true">?</span>
      <div><strong>Which hobby fits you?</strong><span>5 quick questions, no wrong answers.</span></div>
    </a>
    <a class="play2-typing" href="/keyboards/typing-test" style="--c:var(--lavender)">
      <span class="play2-emoji" aria-hidden="true">Aa</span>
      <div><strong>How fast can you type?</strong><span>Race the clock and earn a switch rank.</span></div>
    </a>
  </div>
</Base>

<script>
  // "Try one now"-style random link (kept for any data-random links).
  document.querySelectorAll<HTMLAnchorElement>('a[data-random]').forEach((a) => {
    const urls: string[] = JSON.parse(a.dataset.random || '[]');
    const pick = () => { if (urls.length) a.href = urls[Math.floor(Math.random() * urls.length)]; };
    a.addEventListener('pointerdown', pick);
    a.addEventListener('keydown', (e) => { if (e.key === 'Enter') pick(); });
  });

  // Rabbit hole: show a random wiki word on each visit, and another on "Another word".
  const hole = document.querySelector<HTMLElement>('[data-hole]');
  if (hole) {
    const words: { t: string; s: string; u: string; h: string }[] = JSON.parse(hole.dataset.hole || '[]');
    let last = -1;
    const show = () => {
      if (!words.length) return;
      let i = Math.floor(Math.random() * words.length);
      if (words.length > 1 && i === last) i = (i + 1) % words.length;
      last = i;
      const w = words[i];
      hole.querySelector('[data-hole-hobby]')!.textContent = w.h;
      const link = hole.querySelector<HTMLAnchorElement>('[data-hole-link]')!;
      link.textContent = w.t; link.href = w.u;
      hole.querySelector('[data-hole-text]')!.textContent = w.s;
      hole.querySelector<HTMLAnchorElement>('[data-hole-go]')!.href = w.u;
    };
    show();
    hole.querySelector('[data-hole-next]')!.addEventListener('click', show);
  }
</script>

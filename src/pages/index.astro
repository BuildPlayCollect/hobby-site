---
// index.astro: the home page (the address "/").
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HobbyIcon from '../components/HobbyIcon.astro';
import WikiUpdates from '../components/WikiUpdates.astro';
import NewsRoundup from '../components/NewsRoundup.astro';
import { HOBBIES, TYPES, type HobbyKey, type TypeKey } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// News roundups (written by the Mon/Thu update, named news-roundup-DATE) get their own section,
// so they never crowd the stories below.
const roundups = articles.filter((a) => a.id.startsWith('news-roundup-'));
const stories = articles.filter((a) => !roundups.includes(a));
const featured = stories.find((a) => a.data.featured);
// Top stories: the featured story (if one is switched on), the newest story,
// then the newest story from each hobby. Capped at 6 so it never floods.
// The first one is the big lead story; the rest go in the numbered list beside it.
// It rebuilds itself every time an article is added, no editing needed.
const headlines = [featured, stories[0], ...Object.keys(HOBBIES).map((key) => stories.find((a) => a.data.hobby === key))]
  .filter((a, i, all) => a && all.indexOf(a) === i)
  .slice(0, 6) as typeof stories;
// Everything else that's new goes in "Fresh off the press", newest first, at most 6.
const latest = stories.filter((a) => !headlines.includes(a)).slice(0, 6);
const wiki = (await getCollection('wiki')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const rulebooks = (await getCollection('rules')).length;

// "Try one now" opens a random article that has a 60-second version (any live article if none do yet).
// The link points at the newest headline first, so it still works if scripts are off.
const withQuick = articles.filter((a) => a.data.quick?.length);
const tryUrls = (withQuick.length ? withQuick : articles).map((a) => `/articles/${a.id}/`);

// "Start here" steps for first-time visitors.
const steps = [
  { title: 'Pick a hobby', text: 'Every hobby in the index below has its own page of stories, guides and history.', href: '#hobby-index', link: 'See the index' },
  { title: 'Read the 60-second version', text: 'Every article opens with a short summary, so you get the gist before the deep dive.', href: headlines[0] ? `/articles/${headlines[0].id}/` : '/guides', link: 'Try one now', random: true },
  { title: 'Fall down the rabbit hole', text: 'Hobby words are linked to our wiki. Hover for a quick meaning, click to keep going.', href: '/wiki', link: 'Open the wiki' },
];
const lead = headlines[0];
const sideList = headlines.slice(1);
const pad = (n: number) => String(n).padStart(2, '0');
const countFor = (key: string) => stories.filter((a) => a.data.hobby === key).length;
---
<Base>
  <!-- The nameplate: the site's name right across the page, like a magazine cover. -->
  <section class="nameplate" aria-labelledby="site-title">
    <div class="nameplate-meta label">
      <span>A hobby magazine</span>
      <span>{articles.length} {articles.length === 1 ? 'story' : 'stories'} and counting</span>
    </div>
    <h1 class="nameplate-title" id="site-title"><span>Build</span><span>Play</span><span>Collect</span></h1>
    <div class="nameplate-row">
      <p>Nerdy, playful and fact-checked. History, guides, new releases and giveaways for every hobby, from spinning tops to trading cards.</p>
      <!-- Live counts. They update themselves as hobbies, wiki words and rulebooks are added. -->
      <dl class="nameplate-stats">
        <div><dt class="label">Hobbies</dt><dd>{pad(Object.keys(HOBBIES).length)}</dd></div>
        <div><dt class="label">Wiki words</dt><dd>{pad(wiki.length)}</dd></div>
        <div><dt class="label">Rulebooks</dt><dd>{pad(rulebooks)}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Front page: the lead story big on the left, a numbered list of top stories on the right. -->
  {lead && (
    <section class="front" aria-label="Top stories">
      <a class="lead" href={`/articles/${lead.id}/`} style={`--c:${HOBBIES[lead.data.hobby as HobbyKey].color}`}>
        <div class="card-cover">
          {lead.data.cover
            ? <img src={lead.data.cover} alt={lead.data.coverAlt ?? ''} />
            : <span class="card-cover-name">{HOBBIES[lead.data.hobby as HobbyKey].name}</span>}
        </div>
        <p class="kicker"><span class="tag">{HOBBIES[lead.data.hobby as HobbyKey].name}</span><span class="tag tag-plain">{TYPES[lead.data.type as TypeKey].name}</span></p>
        <h2>{lead.data.title}</h2>
        <p>{lead.data.description}</p>
      </a>
      {sideList.length > 0 && (
        <div class="latest-list">
          <h2><span>Top stories</span><span>{pad(sideList.length)}</span></h2>
          <ol>
            {sideList.map((a, i) => (
              <li>
                <a href={`/articles/${a.id}/`} style={`--c:${HOBBIES[a.data.hobby as HobbyKey].color}`}>
                  <span class="latest-num">{pad(i + 1)}</span>
                  <p class="kicker"><span class="tag">{HOBBIES[a.data.hobby as HobbyKey].name}</span><span class="tag tag-plain">{TYPES[a.data.type as TypeKey].name}</span></p>
                  <h3>{a.data.title}</h3>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  )}

  <!-- The hobby index: one big row per hobby. Hover (or tap) fills the row with that hobby's colour. -->
  <div class="section-head" id="hobby-index"><h2>The index</h2><span class="label muted">{pad(Object.keys(HOBBIES).length)} hobbies</span></div>
  <ol class="hobby-index">
    {Object.entries(HOBBIES).map(([key, h], i) => (
      <li>
        <a href={`/${key}`} style={`--c:${h.color}`}>
          <span class="hi-num">{pad(i + 1)}</span>
          <span class="hi-name">{h.name}</span>
          <span class="hi-blurb">{h.blurb}</span>
          <span class="hi-side">
            <span class="hi-count">{countFor(key)} {countFor(key) === 1 ? 'story' : 'stories'}</span>
            <span class="hi-icon"><HobbyIcon hobby={key as HobbyKey} size={54} /></span>
            <span class="hi-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))}
  </ol>

  <!-- The briefing: the latest Mon/Thu news roundup. -->
  <NewsRoundup roundups={roundups} />

  {latest.length > 0 && (
    <>
      <div class="section-head"><h2>Fresh off the press</h2></div>
      <div class="grid">{latest.map((a) => <ArticleCard article={a} />)}</div>
    </>
  )}

  <!-- Little games: the hobby quiz and the typing test, as two poster blocks. -->
  <div class="play">
    <a class="play-quiz" href="/quiz">
      <span class="play-big" aria-hidden="true">?</span>
      <div>
        <span class="label">Quiz · 5 questions</span>
        <h2>Which hobby fits you?</h2>
        <p>No wrong answers. Find the hobby that matches how you like to spend a Saturday.</p>
      </div>
      <span class="play-go">Take the quiz <b aria-hidden="true">→</b></span>
    </a>
    <a class="play-typing" href="/keyboards/typing-test">
      <span class="play-big" aria-hidden="true">⌨</span>
      <div>
        <span class="label">Typing test · Desktop</span>
        <h2>How fast can you type?</h2>
        <p>Race the clock, earn a switch-themed rank and share your score.</p>
      </div>
      <span class="play-go">Start typing <b aria-hidden="true">→</b></span>
    </a>
  </div>

  <!-- Fresh from the wiki: the newest added or updated wiki terms. -->
  <WikiUpdates />

  <!-- Start here: three steps for first-time visitors. -->
  <div class="section-head"><h2>Start here</h2><span class="label muted">New to the site?</span></div>
  <ol class="start">
    {steps.map((s, i) => (
      <li>
        <span class="start-num" aria-hidden="true">{pad(i + 1)}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        <a href={s.href} data-random={s.random ? JSON.stringify(tryUrls) : undefined}>{s.link} →</a>
      </li>
    ))}
  </ol>

  <!-- Every wiki word in one flowing line, like a magazine's glossary. -->
  <div class="section-head"><h2>Glossary</h2><a class="more" href="/wiki">Open the wiki →</a></div>
  <p class="glossary">
    {wiki.map((w, i) => <>{i > 0 && <span aria-hidden="true">/</span>}<a href={`/wiki/${w.id}/`}>{w.data.title}</a></>)}
  </p>

  {Object.entries(HOBBIES).map(([key, h]) => {
    // A hobby gets its own row once it has 3+ articles. Before that, its stories
    // already show up top, so a row would only repeat them.
    const forHobby = stories.filter((a) => a.data.hobby === key).slice(0, 3);
    return forHobby.length >= 3 && (
      <section>
        <div class="section-head">
          <h2><span class="dot" style={`background:${h.color}`}></span>{h.name}</h2>
          <a class="more" href={`/${key}`}>All {h.name} →</a>
        </div>
        <div class="grid">{forHobby.map((a) => <ArticleCard article={a} />)}</div>
      </section>
    );
  })}
</Base>

<script>
  // "Try one now": swap in a random article just before the link is followed.
  document.querySelectorAll<HTMLAnchorElement>('a[data-random]').forEach((a) => {
    const urls: string[] = JSON.parse(a.dataset.random || '[]');
    const pick = () => { if (urls.length) a.href = urls[Math.floor(Math.random() * urls.length)]; };
    a.addEventListener('pointerdown', pick);
    a.addEventListener('keydown', (e) => { if (e.key === 'Enter') pick(); });
  });
</script>

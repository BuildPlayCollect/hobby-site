---
// index.astro: the home page (the address "/").
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Carousel from '../components/Carousel.astro';
import KeyboardHero from '../components/KeyboardHero.astro';
import { HOBBIES } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = articles.find((a) => a.data.featured) ?? articles[0];
// Headline carousel: the featured story, then the newest story from each hobby.
// It rebuilds itself every time an article is added, no editing needed.
const headlines = [featured, ...Object.keys(HOBBIES).map((key) => articles.find((a) => a.data.hobby === key))]
  .filter((a, i, all) => a && all.indexOf(a) === i);
const latest = articles.filter((a) => !headlines.includes(a)).slice(0, 6);
const wiki = (await getCollection('wiki')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const rulebooks = (await getCollection('rules')).length;

// "New here?" steps for first-time visitors.
const steps = [
  { title: 'Pick a hobby', text: 'Press any key up top. Every hobby gets its own page of stories, guides and history.', href: '#top', link: 'Back to the keys', c: 'var(--blue)' },
  { title: 'Read the 60-second version', text: 'Every article opens with a short summary, so you get the gist before the deep dive.', href: headlines[0] ? `/articles/${headlines[0].id}/` : '/guides', link: 'Try one now', c: 'var(--orange)' },
  { title: 'Fall down the rabbit hole', text: 'Hobby words are linked to our wiki. Hover for a quick meaning, click to keep going.', href: '/wiki', link: 'Open the wiki', c: 'var(--teal)' },
];
---
<Base>
  <section class="hero-keys" id="top" data-bar="overview">
    <div class="hero-copy">
      <p class="code-tag"><span>&lt;hobbies&gt;</span> every one of them <span>&lt;/hobbies&gt;</span></p>
      <h1 class="hero-title">Build<br /><span class="play">Play</span><br />Collect</h1>
      <p class="hero-sub">Nerdy, playful and fact-checked. History, guides, new releases and giveaways, from spinning tops to trading cards.</p>
      <dl class="hero-meta">
        <div><dt>Hobbies</dt><dd>{Object.keys(HOBBIES).length}</dd></div>
        <div><dt>Wiki words</dt><dd>{wiki.length}</dd></div>
        <div><dt>Rulebooks</dt><dd>{rulebooks}</dd></div>
      </dl>
      <div class="hero-actions">
        <a class="arrow-btn" href="#start"><span>New here? Start here</span><i aria-hidden="true">↘</i></a>
        <a class="arrow-btn arrow-btn-light" href="/quiz"><span>Take the quiz</span><i aria-hidden="true">↗</i></a>
      </div>
    </div>
    <KeyboardHero />
  </section>

  <section class="steps-wrap" id="start" data-bar="start">
    <h2 class="big-head">New here?</h2>
    <p class="big-sub">Three steps from "what's a Beyblade?" to "one more article, then bed".</p>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step" style={`--c:${s.c}`}>
          <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <a href={s.href}>{s.link} →</a>
        </li>
      ))}
    </ol>
  </section>

  <section id="stories" data-bar="stories">
    <div class="section-head"><h2 class="big-head">Top stories</h2></div>
    <Carousel label="Top headlines" variant="hero" autoplay>
      {headlines.map((a) => <ArticleCard article={a} large />)}
    </Carousel>

    {latest.length > 0 && (
      <>
        <div class="section-head"><h2>Fresh off the press</h2></div>
        <div class="grid">{latest.map((a) => <ArticleCard article={a} />)}</div>
      </>
    )}
  </section>

  <section class="wiki-band" id="wiki-band" data-bar="wiki">
    <div class="section-head">
      <h2 class="big-head">Rabbit holes</h2>
      <a class="more" href="/wiki">Open the wiki →</a>
    </div>
    <p class="big-sub">Every word below is a wiki page. Pick one and see where it takes you.</p>
    <div class="wiki-keys">
      {wiki.map((w) => <a class="wiki-key" href={`/wiki/${w.id}/`}>{w.data.title}</a>)}
    </div>
  </section>

  {Object.entries(HOBBIES).map(([key, h]) => {
    // A hobby gets its own row once it has 3+ articles. Before that, its stories
    // already show in Top stories, so a row would only repeat them.
    const forHobby = articles.filter((a) => a.data.hobby === key).slice(0, 8);
    return forHobby.length >= 3 && (
      <section>
        <div class="section-head">
          <h2><span class="dot" style={`background:${h.color};margin:0`}></span>{h.name}</h2>
          <a class="more" href={`/${key}`}>All {h.name} →</a>
        </div>
        <Carousel label={`Latest ${h.name}`}>
          {forHobby.map((a) => <ArticleCard article={a} />)}
        </Carousel>
      </section>
    );
  })}

  <!-- The section bar: a row of tabs pinned to the bottom of the screen on computers.
       The tab for the part of the page you're looking at lights up. -->
  <nav class="section-bar" aria-label="Sections on this page">
    <a href="#top" data-for="overview">Overview</a>
    <a href="#start" data-for="start">New here?</a>
    <a href="#stories" data-for="stories">Top stories</a>
    <a href="#wiki-band" data-for="wiki">Rabbit holes</a>
    <a class="section-bar-cta" href="/quiz">Take the quiz <i aria-hidden="true">↗</i></a>
  </nav>
</Base>

<script>
  // Light up the section bar tab for whichever section is on screen.
  const tabs = document.querySelectorAll<HTMLAnchorElement>('.section-bar [data-for]');
  const watch = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const name = (e.target as HTMLElement).dataset.bar;
      tabs.forEach((t) => t.classList.toggle('on', t.dataset.for === name));
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('[data-bar]').forEach((s) => watch.observe(s));
</script>

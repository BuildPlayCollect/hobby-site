---
// index.astro: the home page (the address "/").
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Carousel from '../components/Carousel.astro';
import HobbySelect from '../components/HobbySelect.astro';
import PixelSprite from '../components/PixelSprite.astro';
import Sticker from '../components/Sticker.astro';
import { HOBBIES } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = articles.find((a) => a.data.featured) ?? articles[0];
// Headline carousel: the featured story, then the newest story from each hobby.
// It rebuilds itself every time an article is added, no editing needed.
const headlines = [featured, ...Object.keys(HOBBIES).map((key) => articles.find((a) => a.data.hobby === key))]
  .filter((a, i, all) => a && all.indexOf(a) === i);
const latest = articles.filter((a) => !headlines.includes(a)).slice(0, 6);
const wiki = (await getCollection('wiki')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Base>
  <!-- Title screen: like the first screen of an old video game. -->
  <section class="title-screen">
    <div class="title-floor" aria-hidden="true"></div>
    <div class="title-sprites" aria-hidden="true">
      <PixelSprite name="coin" size={40} class="fly f1" />
      <PixelSprite name="consoles" size={72} class="fly f2" />
      <PixelSprite name="tcg" size={52} class="fly f3" />
      <PixelSprite name="heart" size={36} class="fly f4" />
      <PixelSprite name="tamiya" size={68} class="fly f5" />
      <PixelSprite name="sparkle" size={30} class="fly f6" />
    </div>
    <Sticker text="ALL HOBBIES!" color="var(--yellow)" size={112} tilt={10} class="title-sticker" />
    <p class="title-kicker">Hobby history · guides · new releases</p>
    <h1 class="title-logo"><span>Build</span> <span class="t-play">Play</span> <span>Collect</span></h1>
    <p class="title-sub">Nerdy, playful and fact-checked. Every hobby, from spinning tops to trading cards.</p>
    <div class="title-actions">
      <a class="pixel-btn" href="#select">Press start ▶</a>
      <a class="pixel-btn ghost" href="/wiki">Fall down the wiki</a>
    </div>
  </section>

  <HobbySelect />

  <a class="tile quiz-cta" href="/quiz">
    <PixelSprite name="sparkle" size={34} class="qs qs1" />
    <PixelSprite name="sparkle" size={22} class="qs qs2" />
    <div>
      <p class="quiz-kicker">Bonus stage · 5 questions</p>
      <h2>Which hobby <span>fits you?</span></h2>
    </div>
    <span class="pixel-btn">Take the quiz ▶</span>
  </a>

  <div class="section-head"><h2>Top <span class="hl">stories</span></h2></div>
  <Carousel label="Top headlines" variant="hero" autoplay>
    {headlines.map((a) => <ArticleCard article={a} large />)}
  </Carousel>

  {latest.length > 0 && (
    <>
      <div class="section-head"><h2>Fresh off the press</h2></div>
      <div class="grid">{latest.map((a) => <ArticleCard article={a} />)}</div>
    </>
  )}

  <div class="section-head">
    <h2>Fall down the rabbit hole</h2>
    <a class="more" href="/wiki">Open the wiki →</a>
  </div>
  <div class="chip-row" style="flex-wrap:wrap;overflow:visible">
    {wiki.map((w) => <a class="chip wiki-chip" href={`/wiki/${w.id}/`}>{w.data.title}</a>)}
  </div>

  {Object.entries(HOBBIES).map(([key, h]) => {
    // A hobby gets its own row once it has 3+ articles. Before that, its stories
    // already show in Top stories, so a row would only repeat them.
    const forHobby = articles.filter((a) => a.data.hobby === key).slice(0, 8);
    return forHobby.length >= 3 && (
      <section>
        <div class="section-head">
          <h2><span class="dot" style={`background:${h.color};margin:0`}></span>{h.name}</h2>
          <a class="more" href={`/${key}`}>All {h.name} →</a>
        </div>
        <Carousel label={`Latest ${h.name}`}>
          {forHobby.map((a) => <ArticleCard article={a} />)}
        </Carousel>
      </section>
    );
  })}
</Base>

---
// [section].astro: ONE file that makes many pages.
// The square brackets mean "fill this in". getStaticPaths lists every value:
// one page per hobby (/beyblade, /keyboards ...) and one per content type (/guides, /interviews ...).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { HOBBIES, TYPES, TYPE_SLUGS, SCOPE_LABEL } from '../data/site';
import { SPECIAL_EDITIONS } from '../data/bx-special-editions';

export async function getStaticPaths() {
  const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const wiki = await getCollection('wiki');
  const rules = await getCollection('rules');
  const hobbyPages = Object.entries(HOBBIES).map(([key, h]) => ({
    params: { section: key },
    props: {
      title: h.name, intro: h.blurb, color: h.color, isHobby: true,
      articles: articles.filter((a) => a.data.hobby === key),
      terms: wiki.filter((w) => w.data.hobby === key),
      rulebooks: rules.filter((r) => r.data.hobby === key),
    },
  }));
  const typePages = Object.entries(TYPES).map(([key, t]) => ({
    params: { section: TYPE_SLUGS[key as keyof typeof TYPES] },
    props: {
      title: t.plural, intro: `Every ${t.name.toLowerCase()} article, across all hobbies.`, color: 'var(--accent-bright)', isHobby: false,
      articles: articles.filter((a) => a.data.type === key),
      terms: [],
      rulebooks: [],
    },
  }));
  return [...hobbyPages, ...typePages];
}

const { title, intro, color, isHobby, articles, terms, rulebooks } = Astro.props;
// Only offer filter buttons for types this hobby actually has.
const typesHere = Object.entries(TYPES).filter(([key]) => articles.some((a) => a.data.type === key));
// Beyblade X parts cards (Beyblade page only): one card per part type, with live counts from src/data/bx-parts.yaml.
const bx = await getCollection('bxParts');
const n = (...kinds: string[]) => bx.filter((p) => kinds.includes(p.data.kind)).length;
const PART_CARDS = [
  { kind: 'blade', title: 'Blades', count: n('blade'), unit: 'Blades', text: 'The top part. Its shape and weight decide how it hits and defends.' },
  { kind: 'ratchet', title: 'Ratchets', count: n('ratchet'), unit: 'Ratchets', text: 'The middle part. Its name, like 3-60, gives its prongs and height.' },
  { kind: 'bit', title: 'Bits', count: n('bit'), unit: 'Bits', text: 'The tip. It touches the stadium and controls how the Bey moves.' },
  { kind: 'cx', title: 'Custom Line (CX) Blade parts', count: n('lock-chip', 'main-blade', 'assist-blade', 'metal-blade', 'over-blade'), unit: 'parts', text: 'Lock Chips, Main, Assist, Metal and Over Blades to build your own Blade.' },
  { kind: 'special', title: 'Rare BX/UX/CX-00 releases', count: SPECIAL_EDITIONS.length, unit: 'releases', text: 'Special releases listed by the Beyblade X Database, with product codes.' },
];
---
<Base title={title} description={intro}>
  <header class="page-head">
    <h1><span class="dot" style={`background:${color};width:14px;height:14px;margin:0`}></span>{title}</h1>
    <p>{intro}</p>
  </header>

  {isHobby && typesHere.length > 1 && (
    <div class="chip-row filters" role="group" aria-label="Filter by type">
      <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
      {typesHere.map(([key, t]) => <button class="chip" type="button" data-filter={key} aria-pressed="false">{t.plural}</button>)}
    </div>
  )}

  {articles.length === 0
    ? <p class="empty">No articles here yet.</p>
    : <div class="grid" style="margin-top:16px">{articles.map((a) => <ArticleCard article={a} />)}</div>}

  {title === 'Beyblade' && (
    <>
      <div class="section-head"><h2>Beyblade X parts</h2><a class="more" href="/beyblade/parts">Full parts list →</a></div>
      <div class="rules-list parts-cards">
        {PART_CARDS.map((c) => (
          <a class="rules-item" href={`/beyblade/parts/?kind=${c.kind}`}>
            <span class="badge badge-official">{c.count} {c.unit}</span>
            <strong>{c.title}</strong>
            <small>{c.text}</small>
          </a>
        ))}
      </div>
    </>
  )}

  {title === 'Keyboards' && (
    <>
      <div class="section-head"><h2>Keyboard tools</h2></div>
      <div class="rules-list parts-cards">
        <a class="rules-item" href="/keyboards/typing-test">
          <span class="badge badge-official">Free</span>
          <strong>Typing test</strong>
          <small>15, 30 or 60 seconds. Get your WPM and a switch-themed rank. Needs a real keyboard (desktop or laptop).</small>
        </a>
      </div>
    </>
  )}

  {title === 'Esports' && (
    <>
      <div class="section-head"><h2>Pokémon Champions VGC</h2><a class="more" href="/esports/pokemon-champions">Open the hub →</a></div>
      <div class="rules-list parts-cards">
        <a class="rules-item" href="/esports/pokemon-champions#usage">
          <span class="badge badge-official">Updated monthly</span>
          <strong>Usage leaderboards</strong>
          <small>The most used Pokémon in Doubles and Singles, with their top moves, items and partners.</small>
        </a>
        <a class="rules-item" href="/esports/pokemon-champions#teams">
          <span class="badge badge-official">Regionals</span>
          <strong>Top teams and events</strong>
          <small>The top 8 teams from recent Regionals, and what's coming up next.</small>
        </a>
        <a class="rules-item" href="/esports/pokemon-champions/team-builder">
          <span class="badge badge-official">Free</span>
          <strong>Team builder</strong>
          <small>Build a team of six with the most and least used items, natures, stat points and moves.</small>
        </a>
        <a class="rules-item" href="/esports/pokemon-champions/calc">
          <span class="badge badge-official">Free</span>
          <strong>Damage calculator</strong>
          <small>See how hard a move hits, with stat points, items, weather and terrain.</small>
        </a>
      </div>
    </>
  )}

  {rulebooks.length > 0 && (
    <>
      <div class="section-head"><h2>{title} tournament rules</h2><a class="more" href="/rules">All rules →</a></div>
      <div class="rules-list">
        {rulebooks.map((r) => (
          <a class="rules-item" href={`/rules/${r.id}/`}>
            <span class={`badge badge-${r.data.scope}`}>{SCOPE_LABEL[r.data.scope]}</span>
            <strong>{r.data.title}</strong>
            <small>{r.data.summary}</small>
          </a>
        ))}
      </div>
    </>
  )}

  {terms.length > 0 && (
    <>
      <div class="section-head"><h2>{title} wiki</h2><a class="more" href="/wiki">Full wiki →</a></div>
      <div class="chip-row" style="flex-wrap:wrap;overflow:visible">
        {terms.map((w) => <a class="chip wiki-chip" href={`/wiki/${w.id}/`}>{w.data.title}</a>)}
      </div>
    </>
  )}

  <script>
    // Filter buttons: show only the cards of the chosen type.
    document.querySelectorAll('.filters .chip').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var f = btn.dataset.filter;
        document.querySelectorAll('.filters .chip').forEach(function (b) { b.setAttribute('aria-pressed', b === btn); });
        document.querySelectorAll('.grid .card').forEach(function (c) { c.hidden = f !== 'all' && c.dataset.type !== f; });
      });
    });
  </script>
</Base>

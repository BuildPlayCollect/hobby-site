---
// rules/[slug].astro: one page per rulebook (/rules/beyblade-x-official-rules ...).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { HOBBIES, type HobbyKey } from '../../data/site';

export async function getStaticPaths() {
  const rules = await getCollection('rules');
  return rules.map((entry) => ({ params: { slug: entry.id }, props: { entry, rules } }));
}

const { entry, rules } = Astro.props;
const { Content, headings } = await render(entry);
const hobby = HOBBIES[entry.data.hobby as HobbyKey];
const others = rules.filter((r) => r.data.hobby === entry.data.hobby && r.id !== entry.id);
const toc = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={entry.data.title} description={entry.data.summary}>
  <div class="article-layout">
    <article class="article">
      <header class="wiki-hero">
        <p class="kicker">
          <span class="dot" style={`background:${hobby.color}`}></span>
          <a href="/rules">Rules</a> · <a href={`/${entry.data.hobby}`}>{hobby.name}</a>
        </p>
        <h1>{entry.data.title}</h1>
        <p class="wiki-lead">{entry.data.summary}</p>
        <div class="rules-meta">
          <span class={`badge badge-${entry.data.scope}`}>{entry.data.scope === 'local' ? 'Local rules' : 'Official rules'}</span>
          <span>By {entry.data.organizer}</span>
          {entry.data.version && <span>Version: {entry.data.version}</span>}
          <span>Last checked {fmt(entry.data.lastChecked)}</span>
        </div>
      </header>
      <div class="prose"><Content /></div>
      <p class="rules-note">
        This page is a summary. If it ever differs from the organizer's rulebook, the rulebook wins.
        {entry.data.sourceUrl && <> <a href={entry.data.sourceUrl} rel="noopener">Read the full rules</a>.</>}
        Spot something out of date? <a href="/contact">Tell us</a>.
      </p>
    </article>

    <aside class="sidebar">
      <div class="sidebar-sticky sidebar">
        {toc.length > 1 && (
          <div class="panel toc-panel">
            <h2>On this page</h2>
            <nav class="toc">{toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
          </div>
        )}
        {others.length > 0 && (
          <div class="panel">
            <h2>More {hobby.name} rules</h2>
            <div class="related">{others.map((r) => <a href={`/rules/${r.id}/`}>{r.data.title}</a>)}</div>
          </div>
        )}
      </div>
    </aside>
  </div>
</Base>

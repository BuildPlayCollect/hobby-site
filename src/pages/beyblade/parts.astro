---
// beyblade/parts.astro: the Beyblade X parts list (/beyblade/parts).
// The parts themselves live in src/data/bx-parts.yaml; this page only lays them out.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SPECIAL_EDITIONS } from '../../data/bx-special-editions';
import PartPhoto from '../../components/PartPhoto.astro';

const parts = await getCollection('bxParts');
const ofKind = (k: string) => parts.filter((p) => p.data.kind === k);
const blades = ofKind('blade');
const ratchets = ofKind('ratchet');
const bits = ofKind('bit');
const LINE = { basic: 'Basic Line', unique: 'Unique Line', custom: 'Custom Line' };
// Blade groups in the order the wiki lists them (Basic Line first), then A to Z inside each group.
const GROUP_ORDER = ['Main', 'Expand', 'Hasbro debut', 'Ratchet-integrated', 'X-Over Project'];
const LINE_ORDER = ['basic', 'unique', 'custom'];
const rank = (g: string) => (GROUP_ORDER.includes(g) ? GROUP_ORDER.indexOf(g) : GROUP_ORDER.length);
const groupOf = (b: (typeof parts)[number]) => `${LINE[b.data.line]}: ${b.data.group ?? 'Other'}`;
const bladeGroups = [...new Map(blades.map((b) => [groupOf(b), b])).values()]
  .sort((a, b) => LINE_ORDER.indexOf(a.data.line) - LINE_ORDER.indexOf(b.data.line) || rank(a.data.group ?? '') - rank(b.data.group ?? '') || (a.data.group ?? '').localeCompare(b.data.group ?? ''))
  .map(groupOf);
const label = (b: (typeof parts)[number]) => b.data.name ?? b.data.hasbroName ?? '';
for (const list of [blades, bits]) list.sort((a, b) => label(a).localeCompare(label(b)));
ratchets.sort((a, b) => (a.data.abbr ?? '').localeCompare(b.data.abbr ?? '', undefined, { numeric: true }));
// Custom Line (CX) Blades are built from smaller parts, each listed in its own table.
const CX = [
  { kind: 'lock-chip', title: 'Lock Chips', named: true },
  { kind: 'main-blade', title: 'Main Blades', named: true },
  { kind: 'assist-blade', title: 'Assist Blades', named: false },
  { kind: 'metal-blade', title: 'Metal Blades', named: true },
  { kind: 'over-blade', title: 'Over Blades', named: false },
].map((g) => ({ ...g, parts: ofKind(g.kind).sort((a, b) => label(a).localeCompare(label(b))) }));
const cxCount = CX.reduce((n, g) => n + g.parts.length, 0);
// Photos added in Pages CMS ("Part photos"), matched to a part by its full name (Takara Tomy or Hasbro),
// or by the number for Ratchets (3-60). Full names never repeat, unlike short codes such as "F".
// A photo that matches no part, or more than one, stops the build with a message saying which.
const norm = (x?: string) => (x ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
const photos = new Map<string, Awaited<ReturnType<typeof getCollection<'partPhotos'>>>[number]['data']>();
for (const ph of await getCollection('partPhotos')) {
  const want = norm(ph.data.part);
  const hits = parts.filter((p) => [p.data.name, p.data.hasbroName, p.data.kind === 'ratchet' ? p.data.abbr : undefined].some((x) => x && norm(x) === want));
  if (hits.length === 0) throw new Error(`Part photo "${ph.id}": no part is called "${ph.data.part}". Use the part's full name as the parts list shows it, e.g. Free, not F.`);
  if (hits.length > 1) throw new Error(`Part photo "${ph.id}": "${ph.data.part}" matches ${hits.length} parts (${hits.map((h) => h.id).join(', ')}).`);
  photos.set(hits[0].id, ph.data);
}
const search = (...words: (string | undefined)[]) => words.filter(Boolean).join(' ').toLowerCase();
---
<Base title="Beyblade X Parts List" description={`Every Beyblade X Blade, Ratchet and Bit in one searchable list: ${blades.length} Blades, ${ratchets.length} Ratchets and ${bits.length} Bits, plus ${cxCount} Custom Line Blade parts.`}>
  <header class="wiki-hero">
    <p class="kicker"><span class="dot" style="background:#e63946"></span><a href="/beyblade">Beyblade</a> · Parts</p>
    <h1>Beyblade X parts list</h1>
    <p class="muted">Every Bey is a <a href="/wiki/blade/">Blade</a>, a <a href="/wiki/ratchet/">Ratchet</a> and a <a href="/wiki/bit/">Bit</a>. Search or filter below to find any part, with its Takara Tomy and Hasbro names.</p>
    <div class="parts-stats">
      <span><strong>{blades.length}</strong> Blades</span>
      <span><strong>{ratchets.length}</strong> Ratchets</span>
      <span><strong>{bits.length}</strong> Bits</span>
      <span><strong>{cxCount}</strong> CX Blade parts</span>
    </div>
    <label class="sr-only" for="parts-filter">Search parts</label>
    <input id="parts-filter" class="wiki-filter" type="search" placeholder="Search parts, e.g. Dran, 3-60 or Flat" autocomplete="off" />
    <div class="chip-row parts-tabs" role="group" aria-label="Show">
      <button class="chip" type="button" data-kind="all" aria-pressed="true">All</button>
      <button class="chip" type="button" data-kind="blade" aria-pressed="false">Blades</button>
      <button class="chip" type="button" data-kind="ratchet" aria-pressed="false">Ratchets</button>
      <button class="chip" type="button" data-kind="bit" aria-pressed="false">Bits</button>
      <button class="chip" type="button" data-kind="cx" aria-pressed="false">CX Blade parts</button>
      <button class="chip" type="button" data-kind="special" aria-pressed="false">Rare releases</button>
    </div>
  </header>

  <section class="parts-section" data-kind="blade">
    <div class="section-head"><h2>Blades</h2></div>
    <p class="muted">"Not listed" means the Beyblade Wiki gives no name for that company. Ratchet-integrated Blades have a Ratchet built in, so they go straight onto a Bit.</p>
    {bladeGroups.map((g) => (
      <div class="parts-group">
        <h3>{g}</h3>
        <table class="parts-table">
          <thead><tr><th>Takara Tomy name</th><th>Hasbro name</th></tr></thead>
          <tbody>
            {blades.filter((b) => groupOf(b) === g).map((b) => (
              <tr data-search={search(b.data.name, b.data.hasbroName, g)}>
                <td><PartPhoto photo={photos.get(b.id)} />{b.data.name ?? <span class="muted">Not listed</span>}</td>
                <td>{b.data.hasbroName ?? <span class="muted">Not listed</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </section>

  <section class="parts-section" data-kind="ratchet">
    <div class="section-head"><h2>Ratchets</h2></div>
    <p class="muted">The first number is how many prongs the Ratchet has, and the second is its height. A <a href="/wiki/ratchet/">3-60</a> has three prongs and is 6.0 mm tall.</p>
    <table class="parts-table">
      <thead><tr><th>Ratchet</th><th>Name</th><th>Line</th></tr></thead>
      <tbody>
        {ratchets.map((r) => (
          <tr data-search={search(r.data.abbr, r.data.name)}><td><PartPhoto photo={photos.get(r.id)} /><strong>{r.data.abbr}</strong></td><td>{r.data.name}</td><td>{LINE[r.data.line]}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="parts-section" data-kind="bit">
    <div class="section-head"><h2>Bits</h2></div>
    <p class="muted">The letters at the end of a Bey's name are its Bit, so DranSword 3-60<strong>F</strong> uses the <strong>Flat</strong> Bit.</p>
    <table class="parts-table">
      <thead><tr><th>Bit</th><th>Name</th><th>Line</th></tr></thead>
      <tbody>
        {bits.map((b) => (
          <tr data-search={search(b.data.abbr, b.data.name, b.data.group)}><td><PartPhoto photo={photos.get(b.id)} /><strong>{b.data.abbr}</strong></td><td>{b.data.name}{b.data.group && <span class="muted"> ({b.data.group.toLowerCase()})</span>}</td><td>{LINE[b.data.line]}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="parts-section" data-kind="cx">
    <div class="section-head"><h2>Custom Line (CX) Blade parts</h2></div>
    <p class="muted">A Custom Line Blade is built from parts: a Lock Chip, a Main Blade and an Assist Blade. A CX Expand Blade uses a Lock Chip, an Over Blade, a Metal Blade and an Assist Blade. Mix them to make your own Blade.</p>
    {CX.map((g) => (
      <div class="parts-group">
        <h3>{g.title}</h3>
        <table class="parts-table">
          <thead>{g.named ? <tr><th>Takara Tomy name</th><th>Hasbro name</th></tr> : <tr><th>Abbr.</th><th>Name</th></tr>}</thead>
          <tbody>
            {g.parts.map((p) => g.named ? (
              <tr data-search={search(p.data.name, p.data.hasbroName, g.title)}>
                <td><PartPhoto photo={photos.get(p.id)} />{p.data.name ?? <span class="muted">Not listed</span>}</td>
                <td>{p.data.hasbroName ?? <span class="muted">Not listed</span>}</td>
              </tr>
            ) : (
              <tr data-search={search(p.data.abbr, p.data.name, g.title)}>
                <td><PartPhoto photo={photos.get(p.id)} /><strong>{p.data.abbr ?? <span class="muted">Not listed</span>}</strong></td>
                <td>{p.data.name}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </section>

  <section class="parts-section" data-kind="special">
    <div class="section-head"><h2>Rare BX/UX/CX-00 releases</h2></div>
    <p class="muted">Special releases the <a href="https://www.beybxdb.com/beyblades/takara-tomy-beyblade-x" rel="noopener">Beyblade X Database</a> lists as "Rare BX/UX/CX-00", with the product code shown for each. Check the database for how each one was released.</p>
    <table class="parts-table">
      <thead><tr><th>Code</th><th>Release</th></tr></thead>
      <tbody>
        {SPECIAL_EDITIONS.map((s) => <tr data-search={`${s.code} ${s.name}`.toLowerCase()}><td>{s.code}</td><td>{s.name}</td></tr>)}
      </tbody>
    </table>
  </section>

  <p class="empty parts-none" hidden>No parts match that search.</p>

  <p class="rules-note">
    Sources: part names from the Beyblade Wiki's <a href="https://beyblade.fandom.com/wiki/List_of_Basic_Line_parts" rel="noopener">Basic Line</a>, <a href="https://beyblade.fandom.com/wiki/List_of_Unique_Line_parts" rel="noopener">Unique Line</a> and <a href="https://beyblade.fandom.com/wiki/List_of_Custom_Line_parts" rel="noopener">Custom Line</a> parts lists,
    rare releases from the <a href="https://www.beybxdb.com/beyblades/takara-tomy-beyblade-x" rel="noopener">Beyblade X Database</a>. Last checked October 12, 2026.
    Spot a missing part? <a href="/contact">Tell us</a>.
  </p>

  <script is:inline>
    (function () {
      var input = document.getElementById('parts-filter');
      var kind = 'all';
      function apply() {
        var q = input.value.trim().toLowerCase();
        var any = false;
        document.querySelectorAll('.parts-section').forEach(function (sec) {
          var showSec = kind === 'all' || sec.dataset.kind === kind;
          var visibleRows = 0;
          sec.querySelectorAll('tbody tr').forEach(function (tr) {
            var hit = !q || tr.dataset.search.indexOf(q) !== -1;
            tr.hidden = !hit;
            if (hit) visibleRows++;
          });
          sec.querySelectorAll('.parts-group').forEach(function (g) { g.hidden = !g.querySelector('tbody tr:not([hidden])'); });
          sec.hidden = !showSec || visibleRows === 0;
          if (!sec.hidden) any = true;
        });
        document.querySelector('.parts-none').hidden = any;
      }
      input.addEventListener('input', apply);
      // Arriving from site search (/beyblade/parts/?q=dran) fills the box.
      var params = new URLSearchParams(location.search);
      var q = params.get('q');
      if (q) { input.value = q; apply(); }
      var chips = document.querySelectorAll('.parts-tabs .chip');
      function pick(btn) {
        kind = btn.dataset.kind;
        chips.forEach(function (b) { b.setAttribute('aria-pressed', b === btn); });
        apply();
      }
      chips.forEach(function (btn) { btn.addEventListener('click', function () { pick(btn); }); });
      // Arriving from a card on the Beyblade page (/beyblade/parts/?kind=bit) opens that tab.
      var start = document.querySelector('.parts-tabs .chip[data-kind="' + params.get('kind') + '"]');
      if (start) pick(start);
    })();
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../data/site';
---
<Base title="About">
  <div class="prose page-prose">
    <h1>About {SITE_NAME}</h1>
    <p>{SITE_NAME} covers the hobbies we grew up with and still obsess over: Beyblade, Tamiya, mechanical keyboards, trading card games, consoles and esports.</p>
    <p>We write history pieces, brand profiles, buying guides and interviews for collectors, players and builders. (Replace this with your own story.)</p>
    <p>Everything we publish is fact-checked and fair. Read our <a href="/standards">editorial standards</a>.</p>
  </div>
</Base>

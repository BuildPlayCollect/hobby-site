---
// Learn to play Pokémon Champions VGC (/esports/pokemon-champions/learn): a beginner's guide in plain words.
// The facts live in src/data/champions-learn.ts, each with its sources.
import Base from '../../../layouts/Base.astro';
import Mon from '../../../components/champions/Mon.astro';
import { LEARN_TURN, LEARN_TEAM, LEARN_TYPES, LEARN_WORDS, LEARN_TIPS, LEARN_RANKED, type LearnItem } from '../../../data/champions-learn';
import { LEARN, REGULATIONS } from '../../../data/champions';

const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
// Every source used on the page, once each, for the list at the bottom.
const allSources = [...new Set([LEARN_TURN, LEARN_TEAM, LEARN_TYPES, LEARN_WORDS, LEARN_TIPS, LEARN_RANKED].flat().flatMap((x) => x.sources))];
const current = REGULATIONS.find((r) => r.current) ?? REGULATIONS[0];
// The turn, in the order things happen. The rest of LEARN_TURN goes in "Good to know".
const ORDER = ['Both players choose at the same time', 'Switching goes first', 'Mega Evolution happens early in the turn', 'Priority brackets come before Speed', 'Then the faster Pokémon moves first', 'When a Pokémon faints'];
const steps = ORDER.map((t) => LEARN_TURN.find((x) => x.title === t)).filter(Boolean) as LearnItem[];
const turnExtras = LEARN_TURN.filter((x) => !ORDER.includes(x.title));
---
<Base title="Learn to play Pokémon Champions VGC" description="A beginner's guide to Pokémon Champions VGC: how a Doubles turn works, building your first team, type matchups, the words players use, tips from top players and how Ranked works.">
  <header class="page-head">
    <p class="kicker"><a class="tag" href="/esports">Esports</a> <a class="tag tag-plain" href="/esports/pokemon-champions">Pokémon Champions</a></p>
    <h1>Learn to play VGC</h1>
    <p>VGC is how Pokémon is played at official tournaments: Double Battles, two Pokémon each on the field at once. It looks wild at first. By the end of this page you'll know what's going on, and maybe even win a few.</p>
  </header>

  <nav class="lp-jump" aria-label="On this page">
    <a href="#basics">The basics</a><a href="#turn">How a turn works</a><a href="#team">Your team</a><a href="#types">Types</a><a href="#words">Words to know</a><a href="#tips">Tips</a><a href="#ranked">Ranked</a>
  </nav>

  <section id="basics" class="lp-section">
    <div class="section-head"><h2>The basics in 30 seconds</h2></div>
    <ul class="lp-cards lp-basics">
      <li><strong>6 → 4</strong><span>Bring a team of 6. Before each battle you see the other team and pick 4.</span></li>
      <li><strong>2 vs 2</strong><span>Two of your Pokémon battle two of theirs at the same time.</span></li>
      <li><strong>Level 50</strong><span>Every Pokémon is set to level 50, so the team and the plan matter most.</span></li>
      <li><strong>Win</strong><span>Knock out all 4 of the other player's Pokémon.</span></li>
    </ul>
    <p class="lp-note">Right now the rules are <strong>{current.name}</strong>. Each regulation decides which Pokémon are allowed, and it changes every few months.</p>
  </section>

  <section id="turn" class="lp-section">
    <div class="section-head"><h2>How a turn works</h2></div>
    <ol class="lp-steps">
      {steps.map((s) => (
        <li>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          {s.general && <span class="lp-general">Same as the main Pokémon games</span>}
        </li>
      ))}
    </ol>
    <h3 class="lp-sub">Good to know</h3>
    <div class="lp-cards lp-grid">
      {turnExtras.map((s) => (
        <div class="lp-card">
          <h4>{s.title}</h4>
          <p>{s.text}</p>
          {s.general && <span class="lp-general">Same as the main games</span>}
        </div>
      ))}
    </div>
  </section>

  <section id="team" class="lp-section">
    <div class="section-head"><h2>Building your first team</h2></div>
    <p class="lp-lead">You don't have to build from scratch. Champions gives you a starter team, and you can copy real tournament teams from the <a href="/esports/pokemon-champions#usage">usage board</a>. These are the pieces you'll be changing:</p>
    <div class="lp-cards lp-grid">
      {LEARN_TEAM.map((s) => (
        <div class="lp-card">
          <h4>{s.title}</h4>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
    <p class="lp-note">Starter teams you can pick after the first mission:</p>
    <div class="lp-mons">{LEARN.starters.map((n) => <Mon name={n} size="sm" />)}</div>
    <p class="lp-next"><a class="pill-btn" href="/esports/pokemon-champions/team-builder">Try the team builder →</a></p>
  </section>

  <section id="types" class="lp-section">
    <div class="section-head"><h2>Types cheat sheet</h2></div>
    <p class="lp-lead">Types work the same as in the main Pokémon games. Hit a weakness and you deal double damage.</p>
    <div class="lp-cards lp-grid">
      {LEARN_TYPES.map((s) => (
        <div class="lp-card">
          <h4>{s.title}</h4>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
    <p class="lp-next"><a class="pill-btn" href="/esports/pokemon-champions/calc">See real damage in the calculator →</a></p>
  </section>

  <section id="words" class="lp-section">
    <div class="section-head"><h2>Words to know</h2></div>
    <dl class="lp-words">
      {LEARN_WORDS.map((w) => (
        <div><dt>{w.title}</dt><dd>{w.text}</dd></div>
      ))}
    </dl>
  </section>

  <section id="tips" class="lp-section">
    <div class="section-head"><h2>Tips from good players</h2></div>
    <ol class="lp-tips">
      {LEARN_TIPS.map((t) => (
        <li>
          <strong>{t.title}</strong>
          <span>{t.text} {t.by && <a href={t.sources[0]}>({t.by})</a>}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="ranked" class="lp-section">
    <div class="section-head"><h2>Practice and Ranked</h2></div>
    <div class="lp-cards lp-grid">
      {LEARN_RANKED.map((s) => (
        <div class="lp-card">
          <h4>{s.title}</h4>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="lp-section lp-end">
    <h2>Ready?</h2>
    <p>Pick a starter, play a few Casual battles, then copy a team from the <a href="/esports/pokemon-champions#teams">Regionals results</a> and tweak it in the <a href="/esports/pokemon-champions/team-builder">team builder</a>. Every champion started as a beginner too.</p>
  </section>

  <section class="lp-section">
    <h2 class="lp-sources-h">Sources</h2>
    <ul class="lp-sources">{allSources.map((u) => <li><a href={u}>{(host(u) + new URL(u).pathname).replace(/\/$/, '')}</a></li>)}</ul>
  </section>
</Base>

<style>
  .lp-jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 24px; }
  .lp-jump a { padding: 6px 14px; border: 2px solid var(--line); border-radius: 999px; font-weight: 700; font-size: .85rem; color: var(--ink); background: var(--surface); }
  .lp-jump a:hover { text-decoration: none; background: var(--mark); color: #1b1a1f; }
  .kicker .tag + .tag { margin-left: 6px; }
  .lp-section { margin-top: 44px; }
  .lp-lead { max-width: 75ch; }
  .lp-note { color: var(--muted); font-size: .9rem; margin: 12px 0 8px; }
  .lp-sub { margin: 22px 0 10px; font-size: 1.1rem; }
  .lp-cards { list-style: none; margin: 0; padding: 0; }
  .lp-basics { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
  .lp-basics li { display: grid; gap: 4px; padding: 16px; border: 2px solid var(--line); border-radius: 16px; background: var(--surface); box-shadow: var(--lift); }
  .lp-basics strong { font-family: var(--display); font-size: 1.8rem; line-height: 1; color: var(--c1); }
  .lp-grid { columns: 3 260px; column-gap: 10px; }
  .lp-card { break-inside: avoid; margin-bottom: 10px; padding: 12px 16px; border: 2px solid var(--line); border-radius: 14px; background: var(--surface); }
  .lp-card h4 { margin: 0 0 4px; font-size: 1rem; }
  .lp-card p { margin: 0; font-size: .92rem; }
  .lp-general { display: inline-block; margin-top: 6px; font-size: .7rem; font-weight: 800; padding: 1px 8px; border-radius: 99px; background: var(--surface-2); color: var(--muted); }
  .lp-steps { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: 10px; }
  .lp-steps > li { counter-increment: step; position: relative; padding: 14px 18px 14px 62px; border: 2px solid var(--line); border-radius: 16px; background: var(--surface); }
  .lp-steps > li::before { content: counter(step); position: absolute; left: 16px; top: 13px; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--c1); color: #fff; font-family: var(--display); font-weight: 800; }
  .lp-steps > li + li::after { content: ""; position: absolute; left: 31px; top: -12px; width: 2px; height: 12px; background: var(--line); }
  .lp-steps h3 { margin: 0 0 4px; font-size: 1.05rem; }
  .lp-steps p { margin: 0; }
  .lp-mons { display: flex; flex-wrap: wrap; gap: 6px; }
  .lp-next { margin-top: 14px; }
  .lp-words { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; margin: 0; }
  .lp-words div { padding: 12px 14px; border: 2px solid var(--line); border-radius: 14px; background: var(--surface); }
  .lp-words dt { font-weight: 800; font-family: var(--display); }
  .lp-words dd { margin: 2px 0 0; font-size: .9rem; }
  .lp-tips { margin: 0; padding-left: 22px; display: grid; gap: 10px; max-width: 80ch; }
  .lp-tips li { padding-left: 4px; }
  .lp-tips strong { display: block; }
  .lp-tips a { color: var(--muted); font-size: .82rem; }
  .lp-end { padding: 22px 24px; border: 2px solid var(--line); border-radius: 18px; background: var(--c2); color: #1b1a1f; box-shadow: var(--lift); }
  .lp-end h2 { margin: 0 0 6px; }
  .lp-end p { margin: 0; max-width: 75ch; }
  .lp-end a { color: #1b1a1f; font-weight: 800; text-decoration: underline; }
  .lp-sources-h { font-size: 1.1rem; }
  .lp-sources { margin: 0; padding-left: 20px; font-size: .82rem; color: var(--muted); overflow-wrap: anywhere; columns: 2 320px; }
  @media (max-width: 560px) { .lp-steps > li { padding: 52px 14px 14px; } .lp-steps > li + li::after { display: none; } }
</style>

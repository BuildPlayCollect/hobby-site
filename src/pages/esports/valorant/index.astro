---
// The VALORANT hub (/esports/valorant). Facts live in src/data/valorant.ts.
// Images: official Riot press kit (via Gamespress), editorial use only, resized/cropped only,
// credited under each picture. Videos are never stored here: the trailer is an embed from
// the official VALORANT YouTube channel.
import GameHub from '../../../components/esports/GameHub.astro';
import { VALORANT, NEW_IN_VALORANT as N } from '../../../data/valorant';
import { fmtDate } from '../../../lib/esports-hub';

const CREDIT = 'Image: Riot Games press kit via Gamespress';
const sheetSources = N.sheets.map((s) => s.source);
---
<GameHub game={VALORANT} image="/images/esports/valorant/hush-hero.webp" extraSources={[...N.hush.sources, ...sheetSources]} extraJump={[{ href: '#new', label: 'New in VALORANT' }]}>
  <figure slot="hero" class="vl-hero">
    <img src="/images/esports/valorant/hush-hero.webp" width="1920" height="1080" alt="Hush, VALORANT's new Agent, mid-dash in front of a sandstone wall, with pink energy trailing behind her." fetchpriority="high" data-zoom />
    <figcaption>{CREDIT}</figcaption>
  </figure>

  <section id="new" class="gh-section vl-new">
    <div class="section-head"><h2>New in VALORANT</h2></div>

    <article class="vl-hush">
      <figure class="vl-hush-art">
        <img src="/images/esports/valorant/hush-key-art.webp" width="800" height="1000" alt="Hush key art: a woman with long lilac hair in a black jacket, a pistol and glowing objects floating around her." loading="lazy" data-zoom />
        <figcaption>{CREDIT}</figcaption>
      </figure>
      <div>
        <p class="vl-tag">New Agent · arrives {fmtDate(N.hush.arrives, { day: 'numeric', month: 'long', year: 'numeric' })}</p>
        <h3>{N.hush.name}, the {N.hush.role}</h3>
        <p>{N.hush.intro} She's from {N.hush.from}.</p>
        <ul class="vl-abilities">
          {N.hush.abilities.map((a) => <li><span class="vl-key">{a.key}</span><div><strong>{a.name}</strong><span>{a.text}</span></div></li>)}
        </ul>
        <p class="gh-src">Sources: {N.hush.sources.map((s, i) => <>{i > 0 && ', '}<a href={s.url} rel="noopener">{s.label}</a></>)}</p>
      </div>
    </article>

    <div class="vl-video">
      <iframe src={`https://www.youtube-nocookie.com/embed/${N.trailer.id}`} title={N.trailer.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
    <p class="gh-src">Video: the official Hush trailer from the VALORANT YouTube channel.</p>

    <h3 class="gh-sub">Also new since 22 September 2026</h3>
    <div class="vl-sheets">
      {N.sheets.map((s) => (
        <article class="gh-card vl-sheet">
          {s.image && (
            <figure>
              <img src={s.image.src} width={s.image.w} height={s.image.h} alt={s.image.alt} loading="lazy" data-zoom />
              <figcaption>{CREDIT}</figcaption>
            </figure>
          )}
          <p class="vl-tag">{s.kind} · {fmtDate(s.date)}</p>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
          <ul>{s.stats.map((x) => <li>{x}</li>)}</ul>
          <p class="gh-src">Source: <a href={s.source.url} rel="noopener">{s.source.label}</a></p>
        </article>
      ))}
    </div>
  </section>
</GameHub>

<style>
  .vl-hero { margin: 0; }
  .vl-hero img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border: 2px solid var(--line); border-radius: 22px; box-shadow: var(--lift); background: var(--surface-2); }
  figcaption { margin-top: 6px; color: var(--muted); font-size: .75rem; }
  .vl-tag { margin: 0 0 4px; font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .vl-hush { display: grid; gap: 18px; padding: 18px; border: 2px solid var(--line); border-radius: 22px; background: var(--surface); box-shadow: var(--lift); }
  @media (min-width: 760px) { .vl-hush { grid-template-columns: minmax(0, 300px) 1fr; gap: 26px; padding: 22px; } }
  .vl-hush h3 { margin: 0 0 8px; font-size: 1.5rem; }
  .vl-hush p { margin: 0 0 10px; }
  .vl-hush-art { margin: 0; }
  .vl-hush-art img { width: 100%; height: auto; border-radius: 16px; background: #7d7d7d; }
  @media (max-width: 759px) { .vl-hush-art img { max-height: 340px; object-fit: cover; object-position: top; } }
  .vl-abilities { list-style: none; margin: 4px 0 8px; padding: 0; display: grid; gap: 8px; }
  .vl-abilities li { display: grid; grid-template-columns: 76px 1fr; gap: 10px; align-items: start; }
  .vl-abilities strong { display: block; }
  .vl-abilities span:not(.vl-key) { color: var(--muted); font-size: .92rem; }
  .vl-key { display: grid; place-items: center; min-height: 30px; padding: 2px 4px; line-height: 1; text-align: center; white-space: nowrap; letter-spacing: .02em; border-radius: 10px; background: #ff8fc7; color: #1b1a1f; border: 2px solid #1b1a1f; font-weight: 800; font-size: .72rem; text-transform: uppercase; }
  .vl-video { margin-top: 18px; max-width: 820px; aspect-ratio: 16 / 9; border: 2px solid var(--line); border-radius: 20px; overflow: hidden; background: #000; }
  .vl-video iframe { width: 100%; height: 100%; border: 0; display: block; }
  .vl-sheets { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 14px; }
  .vl-sheet figure { margin: -16px -18px 12px; }
  .vl-sheet figure img { width: 100%; height: auto; border-radius: 16px 16px 0 0; border-bottom: 2px solid var(--line); background: #000; }
  .vl-sheet figcaption { padding: 0 18px; }
  .vl-sheet ul { margin: 0 0 8px; padding-left: 18px; font-size: .92rem; }
  .vl-sheet li { margin: 3px 0; }
</style>
